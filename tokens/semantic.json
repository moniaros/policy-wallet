{
  "$schema": "grafi semantic v1 — roles per theme. Values are PRIMITIVE NAMES, never hex; the generator resolves and the guard rejects raw hex here.",
  "light": {
    "surface-base":    "green-50",
    "surface-raised":  "neutral-0",
    "surface-sunken":  "green-100",
    "surface-wash":    "green-100",
    "surface-inverse": "green-900",
    "fg-primary":      "green-800",
    "fg-secondary":    "slate-400",
    "fg-brand":        "green-600",
    "fg-on-brand":     "neutral-0",
    "border-subtle":   "line-200",
    "border-strong":   "line-300",
    "border-focus":    "green-500",
    "state-covered":       "green-600",
    "state-covered-fill":  "green-200",
    "state-gap":           "sand-700",
    "state-gap-fill":      "sand-50",
    "state-gap-border":    "sand-200",
    "state-review":        "slate-400",
    "state-review-fill":   "green-100",
    "action-primary-bg":     "green-600",
    "action-primary-hover":  "green-700",
    "action-secondary-border": "line-300"
  },
  "dark": {
    "surface-base":    "green-900",
    "surface-raised":  "green-800",
    "surface-sunken":  "neutral-1000",
    "surface-wash":    "green-800",
    "surface-inverse": "green-50",
    "fg-primary":      "green-100",
    "fg-secondary":    "green-300",
    "fg-brand":        "green-300",
    "fg-on-brand":     "green-900",
    "border-subtle":   "green-700",
    "border-strong":   "green-500",
    "border-focus":    "green-300",
    "state-covered":       "green-300",
    "state-covered-fill":  "green-700",
    "state-gap":           "sand-200",
    "state-gap-fill":      "green-800",
    "state-gap-border":    "sand-700",
    "state-review":        "green-300",
    "state-review-fill":   "green-800",
    "action-primary-bg":     "green-300",
    "action-primary-hover":  "green-200",
    "action-secondary-border": "green-500"
  },
  "contrastChecks": [
    { "fg": "fg-primary",   "bg": "surface-base",   "min": 4.5 },
    { "fg": "fg-primary",   "bg": "surface-raised", "min": 4.5 },
    { "fg": "fg-secondary", "bg": "surface-base",   "min": 4.5 },
    { "fg": "fg-secondary", "bg": "surface-raised", "min": 4.5 },
    { "fg": "fg-brand",     "bg": "surface-base",   "min": 4.5 },
    { "fg": "fg-on-brand",  "bg": "action-primary-bg", "min": 4.5 },
    { "fg": "state-gap",    "bg": "state-gap-fill", "min": 4.5 },
    { "fg": "state-gap",    "bg": "surface-base",   "min": 4.5 },
    { "fg": "state-covered","bg": "surface-base",   "min": 3,  "nonText": true },
    { "fg": "state-review", "bg": "state-review-fill", "min": 4.5 },
    { "fg": "border-strong","bg": "surface-base",   "min": 1.2, "nonText": true, "note": "decorative hairline — structure, not identification" },
    { "fg": "border-focus", "bg": "surface-base",   "min": 3,  "nonText": true }
  ]
}
