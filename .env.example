

# NextAuth (Required)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="same-as-auth-secret"

# SEO / site identity (lib/seo/site.ts)
# Canonical origin for metadata, sitemap, JSON-LD. Falls back to NEXTAUTH_URL.
# Production: https://policywallet.gr (post apex cutover).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# E-E-A-T facts — omitted from markup while unset; never use placeholders.
# NEXT_PUBLIC_CONTACT_PHONE="+30 21 0000 0000"
# NEXT_PUBLIC_CONTACT_STREET="Odos Paradeigmatos 1"
# NEXT_PUBLIC_CONTACT_CITY="Athens"
# NEXT_PUBLIC_CONTACT_POSTAL_CODE="10000"
# NEXT_PUBLIC_SOCIAL_LINKEDIN="https://www.linkedin.com/company/policywallet"
# NEXT_PUBLIC_SOCIAL_FACEBOOK=""
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
# NEXT_PUBLIC_SOCIAL_X=""

# Sentry (Optional but recommended for production)
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_ORG="your-org-slug"
SENTRY_PROJECT="your-project-slug"
SENTRY_AUTH_TOKEN="your-auth-token"


# AI providers — selected by which API key is set (Gemini -> Anthropic -> OpenAI).
# Per-step models are env-overridable; defaults live in lib/env.ts and every
# default must have an exact TOKEN_COSTS price entry (lib/token-utils.ts).
# GEMINI_API_KEY="your-gemini-api-key"
# ANTHROPIC_API_KEY="your-anthropic-api-key"
# GEMINI_MODEL_EXTRACTION="gemini-3-flash-preview"
# GEMINI_MODEL_GAP_ANALYSIS="gemini-3-flash-preview"
# GEMINI_MODEL_CLARITY_ANALYSIS="gemini-3.1-flash-lite"
# GEMINI_MODEL_QA="gemini-3.1-flash-lite"
# GEMINI_MODEL_FALLBACK="gemini-3.5-flash"
# GEMINI_MODEL_TRANSLATION="gemini-3.1-flash-lite"
# CLAUDE_MODEL_EXTRACTION="claude-sonnet-5"
# CLAUDE_MODEL_GAP_ANALYSIS="claude-sonnet-5"
# CLAUDE_MODEL_CLARITY_ANALYSIS="claude-sonnet-5"
# CLAUDE_MODEL_QA="claude-haiku-4-5"
OPENAI_API_KEY="your-openai-api-key"
FF_AI_FAILOVER_OPENAI="false"
FF_AI_DEGRADED_COMPLETION="true"
FF_AI_REMEDIATION_ALERTS="false"
FF_AI_REMEDIATION_CANARY_MODE="internal"
AI_ALLOW_FULL_FAILOVER="true"
AI_INCIDENT_SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
AI_INCIDENT_PAGERDUTY_ROUTING_KEY="your-pagerduty-routing-key"
AI_INCIDENT_PAGERDUTY_EVENT_URL="https://events.pagerduty.com/v2/enqueue"



# CRM (Optional)
HUBSPOT_ACCESS_TOKEN="pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Payments (Optional)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Brevo) — the single outbound transport for the platform.
# All mail goes through the Brevo REST API via lib/email/email-service.ts.
BREVO_API_KEY="xkeysib-..."
SENDER_EMAIL="info@policywallet.gr"   # MUST be a verified Brevo sender or sends are rejected
SENDER_NAME="PolicyWallet"
# Brevo contact lists. BREVO_LIST_ID_NEWSLETTER receives footer-newsletter signups.
# BREVO_LIST_ID_USERS="1"
# BREVO_LIST_ID_AGENTS="2"
# BREVO_LIST_ID_NEWSLETTER="3"

# Google Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GA_DEBUG_MODE="false"

# Rate Limiting (Optional)
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# Malware scanning for uploads (Optional). When UPLOAD_SCAN_URL is set, every
# server-side upload is POSTed (raw bytes) to this endpoint BEFORE the object
# is stored — e.g. a ClamAV REST bridge. 'infected' rejects the upload;
# scanner errors FAIL CLOSED (upload refused). Unset = hook dormant.
# UPLOAD_SCAN_URL="https://clamav.internal/scan"
# UPLOAD_SCAN_TOKEN="..."                    # optional bearer token

# AI analysis queue (Upstash QStash). When set, AI analysis runs are published
# to a durable, concurrency-capped queue instead of running inline; the signed
# /api/v1/jobs/execute-analysis consumer executes them. Unset = inline fallback.
# QSTASH_TOKEN="..."                        # publish (from QStash dashboard)
# QSTASH_CURRENT_SIGNING_KEY="sig_..."      # consumer signature verification
# QSTASH_NEXT_SIGNING_KEY="sig_..."         # for key rotation
# QSTASH_CALLBACK_BASE_URL="https://<app>"  # public URL QStash calls back (falls back to NEXTAUTH_URL / VERCEL_URL)
# AI_ANALYSIS_PARALLELISM="5"               # max concurrent analyses across the fleet

# Auth hardening
# ENFORCE_EMAIL_VERIFICATION="1"   # require verified email before app/onboarding access (off by default; enable before real traffic)

# Environment
# Do NOT set NODE_ENV here. Next sets it per command (dev -> development,
# build/start -> production). Pinning it to "development" in .env.local
# overrides the production value during `next build`, so React resolves its
# development build inside the server prerender and every static page dies with
# "Cannot read properties of null (reading 'useEffect')" — on randomly varying
# pages, because the export workers race. Next warns about this exactly once,
# as `⚠ You are using a non-standard "NODE_ENV" value in your environment.`

# Cron Jobs (Optional)
CRON_SECRET="set-a-long-random-secret-for-scheduled-jobs"

# Internal ops notifications
# Recipient for signup alerts AND public-form alerts (contact page + footer newsletter).
# This address is also the code default (lib/email/admin-emails.ts), so alerts are never
# dropped when it is unset — and form submissions are persisted to form_submissions either way.
# ADMIN_NOTIFICATION_EMAIL="agentriseinsurance@gmail.com"
