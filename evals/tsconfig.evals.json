{
    "compilerOptions": {
        "target": "ESNext",
        "module": "CommonJS",
        "lib": ["ESNext"],
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "moduleResolution": "node",
        "paths": {
            "@/*": ["./*"]
        },
        "baseUrl": ".."
    },
    "ts-node": {
        "transpileOnly": true
    }
}
