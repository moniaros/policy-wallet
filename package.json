{
  "name": "policy-wallet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint",
    "lint:i18n-changed": "node scripts/check-i18n-hardcoded.js",
    "postinstall": "prisma generate",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "type-check": "tsc --noEmit",
    "lint:utf8": "node scripts/check-utf8.js",
    "lint:encoding": "node scripts/check-mojibake.js",
    "audit:api-auth": "node scripts/audit-api-auth.js",
    "verify:migrations": "node scripts/verify-migration-sync.js",
    "verify:plans": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/verify-plan-entitlements.ts",
    "cleanup:sentinels": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/cleanup-sentinel-policies.ts",
    "eval": "ts-node -r tsconfig-paths/register -P evals/tsconfig.evals.json evals/run.ts",
    "eval:ci": "ts-node -r tsconfig-paths/register -P evals/tsconfig.evals.json evals/run.ts --provider=mock --suite=all",
    "docs:notifications": "node scripts/generate-notification-matrix.mjs",
    "docs:reviews": "node scripts/generate-review-matrix.mjs",
    "verify:gap-catalogue": "tsx -r dotenv/config scripts/verify-gap-catalogue.ts",
    "align:gap-catalogue": "tsx -r dotenv/config scripts/align-gap-catalogue.ts",
    "verify:reference-data": "tsx -r dotenv/config scripts/verify-reference-data.ts",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "prisma": {
    "seed": "ts-node -P prisma/tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.63",
    "@ai-sdk/google": "^3.0.30",
    "@ai-sdk/openai": "^3.0.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@revenuecat/purchases-js": "^1.25.0",
    "@sentry/nextjs": "^10.45.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.93.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "@upstash/qstash": "^2.9.0",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.36.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "^6.0.97",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.2",
    "idb": "^8.0.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "next": "^16.1.1",
    "next-swagger-doc": "^0.4.1",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^9.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.71.1",
    "sonner": "^2.0.7",
    "stripe": "^20.1.2",
    "swagger-ui-react": "^5.31.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.1.6",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.1",
    "jsdom": "^27.4.0",
    "playwright": "^1.58.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tinyglobby": "0.2.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}