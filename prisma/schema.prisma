}

// NOTE (2026-07): `adminLevel` and `permissions` are NOT enforced anywhere.
// Admin authorization is entirely role-string based — a user is an admin iff
// `User.roles` contains "admin" (see lib/admin/admin-guard.ts `verifyAdminRole`
// and proxy.ts). Do NOT gate any feature on these columns; they are reserved for
// a future granular-permission model. Removing them would need a dedicated
// (destructive) migration.
model AdminUser {
  id          String   @id @default(cuid()) @map("admin_user_id")
  userId      String   @unique @map("user_id")
  adminLevel  String   @map("admin_level")
  permissions String[]
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_users")
}

/// One delivery attempt of one business event to one channel.
///
/// `status` is DELIVERY state and nothing else — `queued | sent | failed |
/// skipped | expired`. It used to double as read state on the bell API
/// (`queued` meant unread), while `readAt` meant the same thing everywhere
/// else, so the badge and the dropdown disagreed about the same user and
/// neither mark-read path moved the other's number. `readAt` is now the single
/// definition of read, and it is meaningful only on `in_app` rows: an email is
/// delivered, not read, and counting sent email as unread notifications is what
/// made the shell badge tally every marketing message ever sent.
model NotificationEvent {
  id                String    @id @default(cuid()) @map("event_id")
  userId            String    @map("user_id")
  eventType         String    @map("event_type")
  channel           String
  /// Delivery state only: queued | sent | failed | skipped | expired.
  status            String    @default("queued")
  /// Registry-derived, denormalized so a query can rank without reading code.
  priority          String    @default("normal")
  title             String
  message           String
  relatedObjectType String?   @map("related_object_type")
  relatedObjectId   String?   @map("related_object_id")
  /// Idempotency key scoped to the user. A cron re-run that recomputes the same
  /// finding must not send it twice; a unique partial index enforces it.
  ///
  /// Unique per CHANNEL, not per event: one emission writes one row per channel,
  /// so a user-scoped key alone would make a three-channel notification collide
  /// with itself. The dispatcher's pre-check still asks "any row with this key?",
  /// which is the question that stops the re-send.
  dedupeKey         String?   @map("dedupe_key")
  /// Retry bookkeeping. The old code recorded `failureReason` and nothing ever
  /// read it, so a failed notification was simply lost.
  attempts          Int       @default(0)
  nextAttemptAt     DateTime? @map("next_attempt_at")
  /// When this may first be attempted. Null = immediately.
  ///
  /// Set by the orchestrator when a notification is DEFERRED rather than
  /// dropped — most often by quiet hours. Deferring is the honest response to
  /// "not now": the customer still gets told, at an hour when being told is
  /// welcome. Dropping would lose the notification to a policy that was only
  /// ever about timing.
  scheduledFor      DateTime? @map("scheduled_for")
  /// After this, the notification is no longer worth delivering. A renewal
  /// reminder that arrives three weeks late is worse than one that never came.
  expiresAt         DateTime? @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  sentAt            DateTime? @map("sent_at")
  /// Read state. Meaningful on `in_app` rows only.
  readAt            DateTime? @map("read_at")
  failureReason     String?   @map("failure_reason")
  /// Why a channel was not attempted: preference_off | no_device |
  /// transport_not_configured | no_address. Distinguishing this from `sent` is
  /// the difference between an audit record and a fiction.
  skipReason        String?   @map("skip_reason")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey, channel])
  @@index([userId])
  @@index([eventType])
  // Notifications list is findMany(userId) ordered by createdAt desc.
  @@index([userId, createdAt])
  // The retry worker: failed rows that are due.
  @@index([status, nextAttemptAt])
  // The scheduled-send worker: deferred rows whose hour has come.
  @@index([status, scheduledFor])
  @@map("notification_events")
}

/// A browser push subscription (RFC 8291 Web Push), one row per device.
///
/// Replaces `User.pushToken`, which held a single token: registering a second
/// device silently evicted the first, so a customer with a phone and a laptop
/// could only ever be reached on whichever they opted in from last. In practice
/// it was always null — nothing in the app ever registered a token — which is
/// why every push the dispatcher "sent" was never actually attempted.
model PushDevice {
  id            String    @id @default(cuid()) @map("device_id")
  userId        String    @map("user_id")
  /// The push service URL. Unique: re-subscribing the same browser returns the
  /// same endpoint, so this makes registration idempotent.
  endpoint      String    @unique
  /// RFC 8291 keys from PushSubscription.getKey().
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  lastSuccessAt DateTime? @map("last_success_at")
  /// Consecutive delivery failures. A 404/410 from the push service means the
  /// subscription is gone for good and the row is deleted immediately; this
  /// counter covers the softer failures.
  failureCount  Int       @default(0) @map("failure_count")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

model NotificationPreference {
  id        String   @id @default(cuid()) @map("preference_id")
  userId    String   @map("user_id")
  eventType String   @map("event_type")
  channel   String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channel])
  @@map("notification_preferences")
}

model ActivityLog {
  id           String   @id @default(cuid()) @map("log_id")
