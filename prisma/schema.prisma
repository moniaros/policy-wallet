// One-off €3 unlock of a single policy's full gap report (audit +
// idempotent-fulfillment anchor; the fast-path read is Policy.reportUnlockedAt).
// Two parties (an agent and the policyholder) uploaded the same policy
// (same owner + insurer + policy number). Merging their records requires the
// consent of the side that did not ask for it — never a silent overwrite.
model PolicyMergeRequest {
  id                String    @id @default(cuid()) @map("merge_request_id")
  existingPolicyId  String    @map("existing_policy_id")
  incomingPolicyId  String    @map("incoming_policy_id")
  requestedByUserId String    @map("requested_by_user_id")
  /// The user whose approval is required (the other uploader).
  approverUserId    String    @map("approver_user_id")
  status            String    @default("pending") // 'pending' | 'approved' | 'rejected' | 'cancelled'
  decidedAt         DateTime? @map("decided_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  existingPolicy Policy @relation("MergeExisting", fields: [existingPolicyId], references: [id], onDelete: Cascade)
  incomingPolicy Policy @relation("MergeIncoming", fields: [incomingPolicyId], references: [id], onDelete: Cascade)
  requestedBy    User   @relation("MergeRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  approver       User   @relation("MergeApprover", fields: [approverUserId], references: [id], onDelete: Cascade)

  @@unique([existingPolicyId, incomingPolicyId])
  @@index([approverUserId, status])
  @@map("policy_merge_requests")
}

