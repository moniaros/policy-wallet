generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AnalysisRunStatus {
  queued
  running
  completed
  completed_with_warnings
  failed
  blocked
}

enum AnalysisStepStatus {
  pending
  running
  completed
  failed
  retrying
  skipped
}

enum ConsentType {
  cookie
  terms
  privacy
  ai_processing
}

enum DataExportStatus {
  requested
  processing
  completed
  failed
  expired
}

enum DeletionRequestStatus {
  requested
  in_review
  approved
  processing
  completed
  rejected
  failed
}

model User {
  id                              String                     @id @default(cuid()) @map("user_id")
  name                            String?
  email                           String                     @unique
  emailVerified                   DateTime?
  image                           String?
  preferredLanguage               String                     @default("el") @map("preferred_language")
  roles                           String                     @default("policyholder")
  createdAt                       DateTime                   @default(now()) @map("created_at")
  updatedAt                       DateTime                   @updatedAt @map("updated_at")
  lastActiveAt                    DateTime?                  @map("last_active_at")
  password                        String?
  phoneNumber                     String?                    @map("phone_number")
  pushToken                       String?                    @map("push_token")
  stripeCustomerId                String?                    @unique @map("stripe_customer_id")
  termsVersionAccepted            String?                    @map("terms_version_accepted")
  privacyVersionAccepted          String?                    @map("privacy_version_accepted")
  cookieConsentVersion            String?                    @map("cookie_consent_version")
  consentUpdatedAt                DateTime?                  @map("consent_updated_at")
  consentLocale                   String?                    @map("consent_locale")
  aiProcessingConsentVersion      String?                    @map("ai_processing_consent_version")
  trialAnalysisUsedAt             DateTime?                  @map("trial_analysis_used_at")
  grantsReceived                  AccessGrant[]              @relation("Grantee")
  grantsGiven                     AccessGrant[]              @relation("Granter")
  accounts                        Account[]
  activeSessions                  ActiveSession[]
  adminProfile                    AdminUser?
  agentProfile                    AgentProfile?
  creditTransactions              CreditTransaction[]
  customerRelationshipsAsAgent    CustomerRelationship[]     @relation("Agent")
  customerRelationshipsAsCustomer CustomerRelationship[]     @relation("Customer")
  entitlementUsages               EntitlementUsage[]
  invitesReceived                 Invite[]                   @relation("Invitee")
  invitesSent                     Invite[]                   @relation("Inviter")
  invoices                        Invoice[]
  notifications                   NotificationEvent[]
  notificationPreferences         NotificationPreference[]
  opportunitiesOwned              Opportunity[]
  paymentMethods                  PaymentMethod[]
  policiesCreated                 Policy[]                   @relation("Creator")
  policiesOwned                   Policy[]                   @relation("Owner")
  documentsUploaded               PolicyDocument[]
  policyholderProfile             PolicyholderProfile?
  questionnairesSent              QuestionnaireInstance[]    @relation("Sender")
  questionnairesReceived          QuestionnaireInstance[]    @relation("Receiver")
  questionnaireResponses          QuestionnaireResponse[]
  referralsReceived               Referral[]                 @relation("Referred")
  referralsMade                   Referral[]                 @relation("Referrer")
  securityEvents                  SecurityEvent[]
  sessions                        Session[]
  subscriptions                   Subscription[]
  tasksReceived                   UserTask[]                 @relation("TaskRecipient")
  tasksCreated                    UserTask[]                 @relation("TaskCreator")
  tokenUsage                      TokenUsage[]               @relation("TokenUsage")
  tokenBalance                    TokenBalance?              @relation("TokenBalance")
  tokenPurchases                  TokenPurchase[]            @relation("TokenPurchases")
  reportUnlockPurchases           ReportUnlockPurchase[]     @relation("ReportUnlockPurchases")
  mergeRequestsRaised             PolicyMergeRequest[]      @relation("MergeRequester")
  mergeRequestsToApprove          PolicyMergeRequest[]      @relation("MergeApprover")
  monthlyTokenUsage               MonthlyTokenUsage[]        @relation("MonthlyTokenUsage")
  policyAnalysisRuns              PolicyAnalysisRun[]
  collaborationThreadsCreated     CollaborationThread[]      @relation("CollaborationThreadCreatedBy")
  collaborationThreadsAssigned    CollaborationThread[]      @relation("CollaborationThreadAssignedTo")
  collaborationMessages           CollaborationMessage[]
  collaborationActionsAssigned    CollaborationAction[]      @relation("CollaborationActionAssignee")
  collaborationParticipants       CollaborationParticipant[]
  policyRenewals                  PolicyRenewal[]
  tenantMemberships               TenantMembership[]
  passkeyCredentials              PasskeyCredential[]
  webAuthnChallenges              WebAuthnChallenge[]
  consents                        ConsentAudit[]
  dataExportRequests              DataExportRequest[]
  deletionRequests                DeletionRequest[]
  documentRequestsCreated         DocumentRequest[]
  proposalsCreated                Proposal[]
  GapInstance                     GapInstance[]
  protectionScore                 ProtectionScore?
  recommendations                 RecommendationInstance[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AgentProfile {
  id                 String  @id @default(cuid()) @map("profile_id")
  userId             String  @unique @map("user_id")
  verificationStatus String  @default("pending") @map("verification_status")
  agencyName         String? @map("agency_name")
  licenseNumber      String? @map("license_number")

  // Branding & Profile
  logoUrl    String?
  brandColor String? @default("#10b981")
  website    String?
  phone      String?
  documents  Json? // [{ type: "license", url: "..." }]

  // Commission rates per LoB: { "motor": 15, "health": 20, ... } (percentage)
  commissionRates Json? @map("commission_rates")

  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  submittedAt           DateTime  @default(now()) @map("submitted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_profiles")
}

model PolicyholderProfile {
  id          String @id @default(cuid()) @map("profile_id")
  userId      String @unique @map("user_id")
  preferences Json?

  // Risk Profile Fields
  maritalStatus    String?  @map("marital_status") // e.g. 'single', 'married'
  dependentsCount  Int      @default(0) @map("dependents_count")
  employmentStatus String?  @map("employment_status") // e.g. 'employed', 'self_employed', 'retired'
  ownsHome         Boolean  @default(false) @map("owns_home")
  mortgageAmount   Decimal? @map("mortgage_amount")
  hasPets          Boolean  @default(false) @map("has_pets")
  vehiclesCount    Int      @default(0) @map("vehicles_count")

  // Enhanced Risk Fields (Gap Detection Engine)
  dateOfBirth       DateTime? @map("date_of_birth")
  annualIncome      Decimal?  @map("annual_income")
  occupation        String?   // e.g. 'office_worker', 'manual_labor', 'freelancer'
  riskTolerance     String?   @map("risk_tolerance") // 'conservative', 'moderate', 'aggressive'
  hasLoans          Boolean   @default(false) @map("has_loans")
  loanAmount        Decimal?  @map("loan_amount")
  travelsFrequently Boolean   @default(false) @map("travels_frequently")
  smokingStatus     String?   @map("smoking_status") // 'non_smoker', 'smoker', 'former_smoker'
  lifeEvents        Json?     @map("life_events") // [{type: 'new_baby', date: '2026-03'}]

  // Health & Lifestyle Risk Fields
  gender               String? @map("gender")                // 'male', 'female', 'prefer_not_to_say'
  heightCm             Int?    @map("height_cm")             // used for BMI
  weightKg             Int?    @map("weight_kg")             // used for BMI
  chronicConditions    Json?   @map("chronic_conditions")    // string[] e.g. ['diabetes', 'hypertension']
  familyMedicalHistory Json?   @map("family_medical_history") // string[] e.g. ['heart_disease', 'cancer']
  drivingRecord        String? @map("driving_record")        // 'clean', 'minor_violations', 'major_violations', 'accidents'
  activityLevel        String? @map("activity_level")        // 'sedentary', 'moderate', 'active', 'very_active'

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("policyholder_profiles")
}

model Insurer {
  id        String   @id @default(cuid()) @map("insurer_id")
  name      String   @unique
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("insurers")
}

model InsuranceType {
  id        String   @id @default(cuid()) @map("type_id")
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("insurance_types")
}

model Tenant {
  id         String             @id @default(cuid()) @map("tenant_id")
  name       String
  type       String             @default("agency") // agency | personal
  logoUrl    String?            @map("logo_url")
  brandColor String?            @default("#10b981") @map("brand_color")
  website    String?
  phone      String?
  address    String?
  taxId      String?            @map("tax_id") // ΑΦΜ for Greek agencies
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  members    TenantMembership[]

  @@map("tenants")
}

model TenantMembership {
  id        String    @id @default(cuid()) @map("membership_id")
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  role      String    @default("member") // owner | manager | member
  status    String    @default("active") // active | suspended | invited
  invitedBy String?   @map("invited_by")
  invitedAt DateTime? @map("invited_at")
  joinedAt  DateTime? @map("joined_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model Policy {
  id                   String                @id @default(cuid()) @map("policy_id")
  ownerUserId          String                @map("owner_user_id")
  createdByUserId      String                @map("created_by_user_id")
  policyNumber         String                @map("policy_number")
  insurerName          String                @map("insurer_name")
  lineOfBusiness       String                @map("line_of_business")
  startDate            DateTime              @map("start_date")
  endDate              DateTime              @map("end_date")
  status               String
  premiumAmount        Decimal?              @map("premium_amount")
  premiumCurrency      String?               @default("EUR") @map("premium_currency")
  coverageSummary      String?               @map("coverage_summary")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  acordData            Json?                 @map("acord_data")
  lastAnalyzedAt       DateTime?             @map("last_analyzed_at")
  // One-off €3 gap-report unlock (free tier); survives re-analysis.
  reportUnlockedAt     DateTime?             @map("report_unlocked_at")
  gapInstances         GapInstance[]
  opportunities        Opportunity[]
  creator              User                  @relation("Creator", fields: [createdByUserId], references: [id])
  owner                User                  @relation("Owner", fields: [ownerUserId], references: [id])
  documents            PolicyDocument[]
  tokenUsages          TokenUsage[]          @relation("PolicyTokenUsage")
  analysisRuns         PolicyAnalysisRun[]
  collaborationThreads CollaborationThread[]
  renewals             PolicyRenewal[]
  reportUnlocks        ReportUnlockPurchase[]
  mergeRequestsAsExisting PolicyMergeRequest[] @relation("MergeExisting")
  mergeRequestsAsIncoming PolicyMergeRequest[] @relation("MergeIncoming")

  @@index([ownerUserId])
  @@index([createdByUserId])
  @@index([endDate])
  @@map("policies")
}

model PolicyDocument {
  id               String    @id @default(cuid()) @map("document_id")
  policyId         String    @map("policy_id")
  fileUrl          String    @map("file_url")
  fileName         String    @map("file_name")
  fileSize         Int       @map("file_size")
  source           String
  processingStatus String    @default("pending") @map("processing_status")
  uploadedByUserId String    @map("uploaded_by_user_id")
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  documentHash     String?   @map("document_hash")
  extractionCache  Json?     @map("extraction_cache")
  extractedAt      DateTime? @map("extracted_at")
  policy           Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  uploader         User      @relation(fields: [uploadedByUserId], references: [id])

  @@index([policyId])
  @@index([uploadedByUserId])
  @@index([documentHash])
  @@map("policy_documents")
}

model GapDefinition {
  id              String        @id @default(cuid()) @map("gap_definition_id")
  scope           String        @default("document") // 'document' or 'portfolio'
  slug            String        @unique
  name            String
  title           String
  description     String
  lineOfBusiness  String        @map("line_of_business")
  severity        String
  defaultSeverity String        @map("default_severity")
  ruleId          String        @map("rule_id")
  detectionLogic  Json          @map("detection_logic")
  isActive        Boolean       @default(true) @map("is_active")
  // L4: Versioning — increment on every admin update for audit / rollback
  version         Int           @default(1)
  changedAt       DateTime?     @map("changed_at")
  changedBy       String?       @map("changed_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  instances       GapInstance[]

  @@map("gap_definitions")
}

model GapInstance {
  id                   String                @id @default(cuid()) @map("gap_instance_id")
  policyId             String?               @map("policy_id")
  userId               String?               @map("user_id")
  gapDefinitionId      String                @map("gap_definition_id")
  severity             String
  status               String                @default("open")
  aiExplanation        String?               @map("ai_explanation")
  aiSuggestion         String?               @map("ai_suggestion")
  detectedAt           DateTime              @default(now()) @map("detected_at")
  resolvedAt           DateTime?             @map("resolved_at")
  aiExplanationEl      String?               @map("ai_explanation_el")
  aiSuggestionEl       String?               @map("ai_suggestion_el")
  definition           GapDefinition         @relation(fields: [gapDefinitionId], references: [id])
  policy               Policy?               @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities        Opportunity[]
  collaborationThreads CollaborationThread[]
  recommendations      RecommendationInstance[]

  @@index([policyId])
  @@index([status])
  @@map("gap_instances")
}

model CustomerRelationship {
  id                     String                  @id @default(cuid()) @map("relationship_id")
  agentUserId            String                  @map("agent_user_id")
  policyholderUserId     String                  @map("policyholder_user_id")
  status                 String                  @default("pending_activation")
  activationStatus       String                  @default("no_policies") @map("activation_status")
  createdAt              DateTime                @default(now()) @map("created_at")
  lastInteractionAt      DateTime?               @map("last_interaction_at")
  agent                  User                    @relation("Agent", fields: [agentUserId], references: [id])
  customer               User                    @relation("Customer", fields: [policyholderUserId], references: [id])
  opportunities          Opportunity[]
  questionnaireInstances QuestionnaireInstance[]
  collaborationThreads   CollaborationThread[]
  documentRequests       DocumentRequest[]
  proposals              Proposal[]

  @@unique([agentUserId, policyholderUserId])
  @@map("customer_relationships")
}

model AccessGrant {
  id            String    @id @default(cuid()) @map("grant_id")
  granterUserId String    @map("granter_user_id")
  granteeUserId String    @map("grantee_user_id")
  scope         String
  permissions   String
  status        String    @default("active")
  grantedAt     DateTime  @default(now()) @map("granted_at")
  revokedAt     DateTime? @map("revoked_at")
  grantee       User      @relation("Grantee", fields: [granteeUserId], references: [id])
  granter       User      @relation("Granter", fields: [granterUserId], references: [id])

  @@map("access_grants")
}

model Invite {
  id                   String    @id @default(cuid()) @map("invite_id")
  inviterUserId        String    @map("inviter_user_id")
  inviteeEmail         String    @map("invitee_email")
  inviteeUserId        String?   @map("invitee_user_id")
  inviteType           String    @map("invite_type")
  relationshipType     String?   @map("relationship_type")
  scope                String?
  requestedPermissions String?   @map("requested_permissions")
  token                String    @unique
  expiresAt            DateTime  @map("expires_at")
  consumedAt           DateTime? @map("consumed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  invitee              User?     @relation("Invitee", fields: [inviteeUserId], references: [id])
  inviter              User      @relation("Inviter", fields: [inviterUserId], references: [id])

  @@map("invites")
}

model Opportunity {
  id                   String                @id @default(cuid()) @map("opportunity_id")
  relationshipId       String                @map("relationship_id")
  policyId             String?               @map("policy_id")
  gapInstanceId        String?               @map("gap_instance_id")
  status               String                @default("open")
  nextActionAt         DateTime?             @map("next_action_at")
  notes                String?
  ownerAgentUserId     String                @map("owner_agent_user_id")
  estimatedPremium     Decimal?              @map("estimated_premium")
  estimatedCommission  Decimal?              @map("estimated_commission")
  quotedPremium        Decimal?              @map("quoted_premium")
  wonPremium           Decimal?              @map("won_premium")
  currency             String                @default("EUR")
  lineOfBusiness       String?               @map("line_of_business")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  gapInstance          GapInstance?          @relation(fields: [gapInstanceId], references: [id])
  owner                User                  @relation(fields: [ownerAgentUserId], references: [id])
  policy               Policy?               @relation(fields: [policyId], references: [id])
  relationship         CustomerRelationship  @relation(fields: [relationshipId], references: [id])
  collaborationThreads CollaborationThread[]

  @@index([relationshipId])
  @@index([policyId])
  @@index([ownerAgentUserId])
  @@index([status])
  @@map("opportunities")
}

model QuestionnaireTemplate {
  id              String                  @id @default(cuid()) @map("template_id")
  name            String
  lineOfBusiness  String                  @map("line_of_business")
  version         Int                     @default(1)
  questions       Json
  isActive        Boolean                 @default(true) @map("is_active")
  isSystem        Boolean                 @default(false) @map("is_system")
  createdByUserId String?                 @map("created_by_user_id")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  instances       QuestionnaireInstance[]

  @@index([createdByUserId])
  @@map("questionnaire_templates")
}

model QuestionnaireInstance {
  id                   String                  @id @default(cuid()) @map("instance_id")
  templateId           String                  @map("template_id")
  relationshipId       String                  @map("relationship_id")
  sentToUserId         String                  @map("sent_to_user_id")
  sentByUserId         String                  @map("sent_by_user_id")
  status               String                  @default("pending")
  sentAt               DateTime                @default(now()) @map("sent_at")
  completedAt          DateTime?               @map("completed_at")
  relationship         CustomerRelationship    @relation(fields: [relationshipId], references: [id])
  sender               User                    @relation("Sender", fields: [sentByUserId], references: [id])
  receiver             User                    @relation("Receiver", fields: [sentToUserId], references: [id])
  template             QuestionnaireTemplate   @relation(fields: [templateId], references: [id])
  responses            QuestionnaireResponse[]
  collaborationThreads CollaborationThread[]

  @@map("questionnaire_instances")
}

model QuestionnaireResponse {
  id          String                @id @default(cuid()) @map("response_id")
  instanceId  String                @map("instance_id")
  userId      String                @map("user_id")
  answers     Json
  submittedAt DateTime              @default(now()) @map("submitted_at")
  instance    QuestionnaireInstance @relation(fields: [instanceId], references: [id])
  user        User                  @relation(fields: [userId], references: [id])

  @@map("questionnaire_responses")
}

model Plan {
  id            String         @id @default(cuid()) @map("plan_id")
  planType      String         @map("plan_type")
  name          String
  displayName   String         @map("display_name")
  price         Decimal
  currency      String         @default("EUR")
  billingPeriod String         @map("billing_period")
  entitlements  Json
  stripePriceId String?        @map("stripe_price_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(cuid()) @map("subscription_id")
  userId               String             @map("user_id")
  planId               String             @map("plan_id")
  status               String             @default("active")
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  autoRenew            Boolean            @default(true) @map("auto_renew")
  provider             String             @default("stripe") // 'stripe', 'revenue_cat'
  revenueCatIdentifier String?            @unique @map("revenue_cat_identifier")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripePriceId        String?            @map("stripe_price_id")
  stripeStatus         String?            @map("stripe_status")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  entitlementUsages    EntitlementUsage[]
  invoices             Invoice[]
  plan                 Plan               @relation(fields: [planId], references: [id])
  user                 User               @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model CreditTransaction {
  id              String   @id @default(cuid()) @map("transaction_id")
  userId          String   @map("user_id")
  amount          Int
  transactionType String   @map("transaction_type")
  balanceAfter    Int      @map("balance_after")
  description     String
  referralId      String?  @map("referral_id")
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id])

  @@map("credit_transactions")
}

model Referral {
  id                     String    @id @default(cuid()) @map("referral_id")
  referrerUserId         String    @map("referrer_user_id")
  referredUserId         String?   @map("referred_user_id")
  referredEmail          String    @map("referred_email")
  referredSubscriptionId String?   @map("referred_subscription_id")
  status                 String    @default("pending")
  creditsEarned          Int       @default(0) @map("credits_earned")
  creditedAt             DateTime? @map("credited_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  referred               User?     @relation("Referred", fields: [referredUserId], references: [id])
  referrer               User      @relation("Referrer", fields: [referrerUserId], references: [id])

  @@map("referrals")
}

model Invoice {
  id             String       @id @default(cuid()) @map("invoice_id")
  userId         String       @map("user_id")
  subscriptionId String       @map("subscription_id")
  invoiceNumber  String       @map("invoice_number")
  amount         Decimal
  currency       String       @default("EUR")
  taxAmount      Decimal      @map("tax_amount")
  totalAmount    Decimal      @map("total_amount")
  status         String
  billingDate    DateTime     @map("billing_date")
  pdfUrl         String?      @map("pdf_url")
  paidAt         DateTime?    @map("paid_at")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@map("invoices")
}

model PaymentMethod {
  id          String   @id @default(cuid()) @map("payment_method_id")
  userId      String   @map("user_id")
  type        String   @default("card")
  lastFour    String   @map("last_four")
  brand       String?
  expiryMonth Int?     @map("expiry_month")
