// ── Gap Detection & Recommendation Engine ────────────────────────────

/// One declared life event. Append-only: a correction is a new row that
/// supersedes the old one, because a record that rewrites itself is not a record.
model LifeEventInstance {
  id           String   @id @default(cuid()) @map("life_event_id")
  userId       String   @map("user_id")
  /// `LIFE_EVENT_REGISTRY[].id`. Not an enum — the registry is data, and a DB
  /// enum would make adding an event a migration.
  definitionId String   @map("definition_id")
  occurredAt   DateTime @map("occurred_at")
  /// When WE learned it. Windows run from here, not from occurrence — a customer
  /// telling us in November about a March event has their attention on it now.
  discoveredAt DateTime @default(now()) @map("discovered_at")
  source       String
  confidence   String
  /// Amount for events that carry one (mortgage balance, headcount, valuables).
  magnitude    Decimal?
  status       String   @default("applied") // applied | superseded | retracted
  /// Exactly what was written, so a retraction can reverse cleanly rather than
  /// guess at the prior state.
  appliedPatch Json?    @map("applied_patch")
  supersedesId String?  @map("supersedes_id")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, definitionId])
  @@map("life_event_instances")
}

/// Layer 1 — NEEDS. What the customer SAYS matters, captured by the first-stage
/// onboarding before any policy is read (docs: the personal protection profile).
///
/// Holds no verdict: coverage lives on Policy and its analysis, alignment on
/// GapInstance / RecommendationInstance. Ownership FACTS (children, residence,
/// employment, vehicles, loans) do not live here either — they go to the typed
/// PolicyholderProfile columns the risk engine reads, through the same
/// non-overwriting patch the /protection quick start uses. This row is the
/// person's own statements: why they came, what would hurt most, how confident
/// they feel, what changed and what is coming. A stated priority is a reason
/// to LOOK, never a finding — deriveProtectionPriorities() turns the two stores
/// into "areas to check" on read and persists nothing.
///
/// Its own table rather than `preferences` JSON so it is typed, queryable
/// (product intelligence: GROUP BY intent / confidence), covered automatically by
/// the schema-derived erasure guard, and exported under Art. 15 by name.
model ProtectionProfile {
  id                   String    @id @default(cuid()) @map("protection_profile_id")
  userId               String    @unique @map("user_id")
  /// INTENT_VALUES — why they came.
  intent               String?
  /// RISK_CONCERNS in the order chosen (max 2): what would hurt most.
  riskConcerns         Json?     @map("risk_concerns")
  /// COMMITMENTS — mortgage / loan / rent as flags. Never amounts.
  commitments          Json?
  /// CONFIDENCE_LEVELS — how sure they feel their cover matches what matters.
  confidenceLevel      String?   @map("confidence_level")
  /// UNCERTAINTY_REASONS — asked only when confidence is low.
  uncertaintyReasons   Json?     @map("uncertainty_reasons")
  /// {id, when}[] — LIFE_CHANGE_OPTIONS; registry-backed ones also become
  /// LifeEventInstance rows at completion.
  recentChanges        Json?     @map("recent_changes")
  /// {id, horizon}[] — FUTURE_CONSIDERATIONS.
  futureConsiderations Json?     @map("future_considerations")
  /// GUIDANCE_PREFERENCES — how they want to be guided.
  guidancePreference   String?   @map("guidance_preference")
  /// Snapshot of the derived top domains at completion — analytics only; the
  /// live picture is always recomputed.
  priorityAreas        Json?     @map("priority_areas")
  /// stepId → raw answer, so a refresh returns to the same screen pre-selected.
  answers              Json?
  answeredSteps        Json?     @map("answered_steps")
  /// Where «Δεν είμαι σίγουρος/η» was the answer — the honest lower-confidence
  /// signal, and product intelligence about where people cannot answer.
  unsureSteps          Json?     @map("unsure_steps")
  uploadChoice         String?   @map("upload_choice") // done | later
  version              Int       @default(1)
  startedAt            DateTime  @default(now()) @map("started_at")
  completedAt          DateTime? @map("completed_at")
  skippedAt            DateTime? @map("skipped_at")
  summaryViewedAt      DateTime? @map("summary_viewed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("protection_profiles")
}

/// A versioned snapshot of the risk assessment.
///
/// The current `ProtectionScore` is a single upserted row, so the product cannot
/// answer "what changed and why". This is the history: one row per materially
/// different assessment, stamped with what triggered the recalculation.
model RiskProfileVersion {
  id                 String   @id @default(cuid()) @map("risk_profile_version_id")
  userId             String   @map("user_id")
  version            Int
  computedAt         DateTime @default(now()) @map("computed_at")
  /// life_event | policy_change | profile_update | cron | manual
  trigger            String
  /// The event that caused it, when there was one.
  lifeEventId        String?  @map("life_event_id")
  overallScore       Int      @map("overall_score")
  assessmentCoverage Int?     @map("assessment_coverage")
  indeterminate      Boolean  @default(false)
  /// Per-risk status snapshot — what applied, what was covered, what was open.
  risks              Json
  categoryScores     Json     @map("category_scores")
  openFindingCount   Int      @map("open_finding_count")
  /// Fingerprint of the assessment. A recalculation that produces an identical
  /// hash writes no row, so the history records CHANGES rather than cron ticks.
  contextHash        String   @map("context_hash")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@index([userId, computedAt])
  @@map("risk_profile_versions")
}

model ProtectionScore {
  id                 String   @id @default(cuid()) @map("protection_score_id")
  userId             String   @unique @map("user_id")
  overallScore       Int      @map("overall_score") // 0-100
  categoryScores     Json     @map("category_scores") // { life: 80, health: 100, property: 0, income: 40, liability: 60, other: 0 }
  gapCount           Int      @map("gap_count")
  expectedLines      Json     @map("expected_lines") // ["motor","health","home","life"]
  /// Share of the risk catalog that could be decided, 0-100. Below 50 the score
  /// is not a measure of this person's cover but of what we happened to be able
  /// to answer, and every surface must show "not enough information" instead.
  assessmentCoverage Int?     @map("assessment_coverage")
  actualLines        Json     @map("actual_lines") // ["motor","health"]
  computedAt         DateTime @map("computed_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The refresh cron drives off the stalest scores first.
  @@index([computedAt])
  @@map("protection_scores")
}

// NOTE: a docstring for an append-only `ProtectionScoreHistory` model used to
// sit here. That model was deliberately retired — `RiskProfileVersion` is the
// single score history, because two histories of one number are two answers
// waiting to disagree in front of an advisor. Prisma `///` comments attach to
// the NEXT declaration, so the orphan was documenting RecommendationInstance in
// the generated client. Left as a plain comment; the dead `protection_score_history`
// table is dropped in the notification-bus migration.

model RecommendationInstance {
  id               String   @id @default(cuid()) @map("recommendation_id")
  userId           String   @map("user_id")
  gapInstanceId    String?  @map("gap_instance_id")
  lineOfBusiness   String   @map("line_of_business")
  ruleId           String?  @map("rule_id") // e.g. 'mortgage_no_life'
  title            Json // { en: "...", el: "..." }
  description      Json // { en: "...", el: "..." }
  urgency          String // 'critical', 'high', 'medium', 'low'
  estimatedCostEur Decimal? @map("estimated_cost_eur") @db.Decimal(10, 2)
  personalReason   Json     @map("personal_reason") // { en: "You have a mortgage...", el: "..." }
  status           String   @default("active") // 'active', 'dismissed', 'actioned'

  // ── Life Context Risk Assessment payload ────────────────────────────────
  // Every recommendation must be able to answer: does this risk exist, could
  // they suffer it, and is insurance the right answer. These carry that answer
  // to the UI instead of it being re-derived per surface.
  /// RiskStatus: not_applicable | needs_review | already_covered |
  /// protection_gap | opportunity | applicable
  riskStatus        String?      @map("risk_status")
  /// RiskConfidence: high | medium | low — how much rests on answered facts.
  confidence        String?      @map("confidence")
  /// The catalog risk this came from (`RISK_CATALOG[].id`), when applicable.
  riskId            String?      @map("risk_id")
  expectedImpact    Json?        @map("expected_impact") // { en, el }
  /// Everything that can be done about the risk — avoid / reduce / retain /
  /// transfer. Insurance appears here as ONE option among others; the card is
  /// built from this, not from suggestedSolution.
  mitigations       Json?        @map("mitigations") // Mitigation[]
  suggestedSolution Json?        @map("suggested_solution") // { en, el } — the transfer option, derived
  /// Market reality that qualifies the suggestion (e.g. pre-existing-condition
  /// exclusions, life underwriting age ceilings). Shown verbatim on the card.
  eligibilityNote   Json?        @map("eligibility_note") // { en, el } | null
  dismissReason     String?      @map("dismiss_reason")
  actionedAt        DateTime?    @map("actioned_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gapInstance       GapInstance? @relation(fields: [gapInstanceId], references: [id], onDelete: SetNull)

  productId String?           @map("product_id")
  product   InsuranceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Exactly one row per (user, rule): the engine has ten call sites, five of
  // them unawaited background promises, and the old read-then-write sync
  // raced itself into three identical active rows for the same rule.
  @@unique([userId, ruleId])
  @@index([userId, status])
  @@index([urgency])
  // The recommendations list groups by assessment status.
  @@index([userId, riskStatus])
  @@map("recommendation_instances")
}

// ── Insurance Product Catalog ────────────────────────────────────────────────
// Greek market insurance products linked to specific lines of business.
// Used for product matching in recommendations and cross-sell.

model InsuranceProduct {
  id                     String                   @id @default(cuid()) @map("product_id")
  lineOfBusiness         String                   @map("line_of_business") // motor, home, health, life, travel, pet, liability, legal_expenses
  name                   Json // { en: "...", el: "..." }
  description            Json // { en: "...", el: "..." }
  category               String                   @default("individual") // individual, group, corporate
  estimatedAnnualPremium Decimal                  @map("estimated_annual_premium") @db.Decimal(10, 2)
  premiumRangeLow        Decimal?                 @map("premium_range_low") @db.Decimal(10, 2)
  premiumRangeHigh       Decimal?                 @map("premium_range_high") @db.Decimal(10, 2)
  keyBenefits            Json?                    @map("key_benefits") // [{ en: "...", el: "..." }, ...]
  idealProfileTags       String[]                 @map("ideal_profile_tags") // e.g. ['homeowner', 'has_dependents', 'self_employed']
  urgencyForProfiles     String                   @default("medium") @map("urgency_for_profiles") // critical, high, medium, low
  greekMarketPopularity  Int                      @default(50) @map("greek_market_popularity") // 0-100
  isActive               Boolean                  @default(true) @map("is_active")
  sortOrder              Int                      @default(0) @map("sort_order")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  recommendations        RecommendationInstance[]

  @@index([lineOfBusiness, isActive])
  @@index([isActive, sortOrder])
  @@map("insurance_products")
}

/// Public-form captures (contact page, footer newsletter). Deliberately NOT
/// NotificationEvent: that model requires a userId FK and these submitters are
/// anonymous. Rows are written before any Brevo call, so a mail failure degrades
/// to emailSent=false rather than losing the submission.
model FormSubmission {
  id        String   @id @default(cuid()) @map("submission_id")
  formType  String   @map("form_type") // "contact" | "newsletter"
  email     String
  name      String?
  phone     String?
  subject   String?
  message   String?
  locale    String   @default("el")
  source    String? // e.g. "footer_newsletter", "contact_page"
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  emailSent Boolean  @default(false) @map("email_sent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([formType, createdAt])
  @@map("form_submissions")
}

/// Third-party partner offering benefits bundled into paid tiers (the
/// "partner offers" program — distinct from a policy's OWN embedded
/// perksAndBenefits). Admin-managed via /admin/partners; isActive defaults
/// FALSE so nothing renders anywhere until an admin deliberately activates a
/// real, signed partner (repo honesty rule: never market what isn't live).
model PartnerVendor {
  id          String         @id @default(cuid()) @map("vendor_id")
  slug        String         @unique
  name        String
  description Json // { el, en }
  logoUrl     String?        @map("logo_url")
  websiteUrl  String?        @map("website_url")
  category    String         @default("lifestyle") // health|motor|home|pet|travel|digital|lifestyle
  isActive    Boolean        @default(false) @map("is_active")
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  offers      PartnerOffer[]

  @@index([isActive, sortOrder])
  @@map("partner_vendors")
}

/// A concrete redeemable offer from a partner vendor. Tier-gated via
/// includedInTiers (plan-catalog tierKeys) and targeted via profileTags
/// (deriveProfileTags vocabulary) / linesOfBusiness (taxonomy branch ids).
/// Slugs are stable so a future PartnerOfferRedemption log can reference
/// offers across edits. An offer renders only while BOTH it and its vendor
/// are active and now is inside the validity window.
model PartnerOffer {
  id               String        @id @default(cuid()) @map("offer_id")
  vendorId         String        @map("vendor_id")
  slug             String        @unique
  title            Json // { el, en }
  description      Json // { el, en }
  offerType        String        @map("offer_type") // free_service|discount|gift
  redemptionMethod String        @map("redemption_method") // link|code|phone
  redemptionUrl    String?       @map("redemption_url")
  redemptionCode   String?       @map("redemption_code")
  redemptionPhone  String?       @map("redemption_phone")
  includedInTiers  String[]      @map("included_in_tiers")
  profileTags      String[]      @map("profile_tags")
  linesOfBusiness  String[]      @map("lines_of_business")
  validFrom        DateTime?     @map("valid_from")
  validUntil       DateTime?     @map("valid_until")
  termsUrl         String?       @map("terms_url")
  isActive         Boolean       @default(false) @map("is_active")
  sortOrder        Int           @default(0) @map("sort_order")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  vendor           PartnerVendor @relation(fields: [vendorId], references: [id])

  @@index([isActive, sortOrder])
  @@index([vendorId])
  @@map("partner_offers")
}

/// Phase 6b: admin-managed runtime AI model routing (DB override > env default).
/// One row per config key — the six route operations plus the sentinel
/// "primaryProvider" (provider-only). A row is either provider="auto" with a
/// NULL model (pure env behavior, equivalent to no row) or fully pinned. The
/// cached reader (lib/services/ai/runtime-config.ts) falls back to env defaults
/// on any missing/invalid row or DB error — an AI call must never fail because
/// config is unreadable.
model AiRuntimeConfig {
  id        String   @id @default(cuid()) @map("config_id")
  configKey String   @unique @map("config_key")
  provider  String   @default("auto") // auto | gemini | anthropic | openai | mock
  model     String? // NULL iff provider = "auto"; required otherwise
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(1)
  changedBy String?  @map("changed_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  revisions AiRuntimeConfigRevision[]

  @@map("ai_runtime_config")
}

/// Immutable audit trail per AiRuntimeConfig write (PlanRevision shape):
/// full post-change snapshot + per-field {from,to} diff + who changed it.
model AiRuntimeConfigRevision {
  id             String   @id @default(cuid()) @map("revision_id")
  configId       String   @map("config_id")
  version        Int
  snapshot       Json
  changes        Json
  changedBy      String   @map("changed_by")
  changedByEmail String   @map("changed_by_email")
  createdAt      DateTime @default(now()) @map("created_at")

  config AiRuntimeConfig @relation(fields: [configId], references: [id])

  @@index([configId, createdAt])
  @@map("ai_runtime_config_revisions")
}

/// Admin-authored operator guidance appended to one AI operation's prompt,
/// optionally scoped to a single line of business. lineOfBusiness uses the
/// "__global__" sentinel instead of NULL — Postgres unique indexes treat NULLs
/// as distinct, which would permit duplicate global rows for one operation.
/// Guidance is ADDITIVE only: it renders under an "OPERATOR GUIDANCE" label
/// after the canonical task rules and can never replace the compliance persona
/// (enforced at save time by validateOperatorGuidance).
model AiPromptOverride {
  id             String   @id @default(cuid()) @map("override_id")
  operation      String // extractPolicyData | analyzeGaps | analyzePolicyClarity | askQuestion | analyzeRiskProfile
  lineOfBusiness String   @default("__global__") @map("line_of_business")
  guidance       String   @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  version        Int      @default(1)
  changedBy      String?  @map("changed_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  revisions AiPromptOverrideRevision[]

  @@unique([operation, lineOfBusiness])
  @@index([operation, isActive])
  @@map("ai_prompt_overrides")
}

/// Immutable audit trail per AiPromptOverride write (PlanRevision shape):
/// full post-change snapshot + per-field {from,to} diff + who changed it.
model AiPromptOverrideRevision {
  id             String   @id @default(cuid()) @map("revision_id")
  overrideId     String   @map("override_id")
  version        Int
  snapshot       Json
  changes        Json
  changedBy      String   @map("changed_by")
  changedByEmail String   @map("changed_by_email")
  createdAt      DateTime @default(now()) @map("created_at")

  override AiPromptOverride @relation(fields: [overrideId], references: [id])

  @@index([overrideId, createdAt])
  @@map("ai_prompt_override_revisions")
}

// ── Notification administration ──────────────────────────────────────────────
//
// Specification: docs/architecture/notification-automation.md
//
// The registry (lib/notifications/registry.ts) remains the source of truth for
// an event's SHAPE and its safety-critical properties. These tables are an
// OVERRIDE layer over its operational parameters, so an operator can retune
// thresholds, channels, retries and copy without a deploy — mirroring the
// AiPromptOverride pattern, including revisions for versioning.
//
// What is deliberately NOT overridable: `transactional`, `category` and
// `recipients`. Making `transactional` editable would let an administrator
// silence a password-change or payment-failure alert for a customer who never
// agreed to that — the one class of notification nobody may switch off. A rule
// the operator can bend must never be the rule protecting the customer FROM the
// operator.

/// Per-event override of the registry's operational parameters.
///
/// Every column is NULLABLE and null means INHERIT. That matters: an override
/// row is a set of deltas, not a copy, so a registry default that improves in a
/// later release still reaches events an operator once touched for one field.
model NotificationRuleOverride {
  id        String @id @default(cuid()) @map("override_id")
  /// Registry key. Unknown keys are ignored by the loader rather than crashing.
  eventType String @unique @map("event_type")

  /// The trigger switch. False = the event stops firing; the dispatcher records
  /// a `skipped` row with `trigger_disabled` rather than nothing at all,
  /// because "we suppressed this deliberately" is exactly what an audit needs.
  enabled  Boolean?
  priority String?
  /// Allowed channels for this event, as a JSON string[]. Can only NARROW the
  /// registry's declared set — widening it would let an operator route an
  /// in-app-only event to email, which is a product decision, not a setting.
  channels Json?

  retryAttempts         Int?    @map("retry_attempts")
  retryBackoff          String? @map("retry_backoff")
  retryBaseDelayMinutes Int?    @map("retry_base_delay_minutes")

  escalationAfterFailures    Int? @map("escalation_after_failures")
  escalationAfterUnreadHours Int? @map("escalation_after_unread_hours")

  expiresAfterHours Int? @map("expires_after_hours")

  /// Why an operator changed this. Free text, shown next to the value.
  notes     String?  @db.Text
  version   Int      @default(1)
  changedBy String?  @map("changed_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  revisions NotificationRuleRevision[]

  @@map("notification_rule_overrides")
}

model NotificationRuleRevision {
  id             String   @id @default(cuid()) @map("revision_id")
  overrideId     String   @map("override_id")
  version        Int
  snapshot       Json
  changes        Json
  changedBy      String   @map("changed_by")
  changedByEmail String   @map("changed_by_email")
  createdAt      DateTime @default(now()) @map("created_at")

  override NotificationRuleOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)

  @@index([overrideId, createdAt])
  @@map("notification_rule_revisions")
}

/// Admin-authored copy for one event on one channel in one language.
///
/// Absent = the caller's own copy is used, which is what every notification did
/// before this existed. A template is therefore additive: it lets an operator
/// take over the wording of an event without any code path depending on one
/// being present.
model NotificationTemplate {
  id        String @id @default(cuid()) @map("template_id")
  eventType String @map("event_type")
  /// in_app | email | push. Channels render different things: email has a
  /// subject and HTML, push has a short title and body, in-app has both plain.
  channel   String
  /// el | en. Both are first-class; Greek is the product default.
  locale    String

  /// Email only. Ignored on other channels.
  subject String? @db.Text
  title   String  @db.Text
  body    String  @db.Text

  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(1)
  changedBy String?  @map("changed_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  revisions NotificationTemplateRevision[]

  @@unique([eventType, channel, locale])
  @@index([eventType, isActive])
  @@map("notification_templates")
}

model NotificationTemplateRevision {
  id             String   @id @default(cuid()) @map("revision_id")
  templateId     String   @map("template_id")
  version        Int
  snapshot       Json
  changes        Json
  changedBy      String   @map("changed_by")
  changedByEmail String   @map("changed_by_email")
  createdAt      DateTime @default(now()) @map("created_at")

  template NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt])
  @@map("notification_template_revisions")
}

/// Global operational settings: the kill switches, channel toggles, thresholds
/// and feature flags that are not per-event.
///
/// Key/value rather than a column per setting, because the alternative is a
/// migration every time an operator needs a new dial — which is precisely the
/// deploy this whole layer exists to avoid. Keys and their types are declared
/// in lib/notifications/settings.ts, so the value is still validated and the
/// admin UI is generated from the declaration rather than hand-maintained.
model NotificationSetting {
  key       String   @id
  /// Validated against the declared schema for this key before it is written.
  value     Json
  changedBy String?  @map("changed_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_settings")
}

// ── Business events ──────────────────────────────────────────────────────────
//
// Specification: docs/architecture/business-events.md
//
// A business event is a fact that happened in the insurance domain, stated in
// the past tense, that would still be true if PolicyWallet had no
// notifications, no AI and no advisors. Everything else — a notification, a
// recommendation, an advisor task, a score recomputation — is a consumer's
// REACTION to that fact. Producers never know their consumers exist.
//
// This is an OUTBOX, not an in-process emitter. The row is written in the same
// transaction as the fact it describes, so the two cannot disagree: either both
// happened or neither did. An in-process emitter has the exact failure mode the
// audit found on the upload path — a floating promise a serverless function may
// terminate before it runs.
//
// It is NOT event sourcing. Prisma models remain the system of record; this is
// an append-only record of facts, used to drive reactions and to replay them.

/// One business fact. Append-only — never updated, never deleted except by the
/// retention sweep and by GDPR erasure via `subjectUserId`.
model BusinessEvent {
  id      String @id @default(cuid()) @map("event_id")
  /// `aggregate.verb_past` — e.g. `policy.analysis_completed`. Never a channel
  /// or a feature name: the name is the public contract for external consumers.
  name    String
  /// Payload schema version. Additive-only within a major; a breaking change is
  /// a new version with an upcaster, so a two-year-old event still replays.
  version Int    @default(1)

  /// When the FACT happened — not when we learned it. A life event declared
  /// today may have occurred last year; a claim is registered weeks after the
  /// incident. Every date-dependent business rule reads this.
  occurredAt DateTime @map("occurred_at")
  /// When we recorded it. Every operational rule (retry, expiry, SLA) reads this.
  recordedAt DateTime @default(now()) @map("recorded_at")

  aggregateType String @map("aggregate_type")
  aggregateId   String @map("aggregate_id")
  /// Monotonic per aggregate. The ONLY ordering guarantee — global ordering is
  /// deliberately not offered (it forces everything through one queue for a
  /// benefit almost nothing needs).
  sequence      Int

  /// WHOSE data this is. The GDPR anchor: erasure and subject-access walk this,
  /// never `actorId`. An advisor uploading for a customer is actor=advisor,
  /// subject=customer, and collapsing the two misattributes the record,
  /// misroutes the notification and loses the access log.
  subjectUserId String? @map("subject_user_id")
  /// Who caused it: customer | advisor | system | admin.
  actorType     String  @map("actor_type")
  actorId       String? @map("actor_id")

  /// The whole causal chain — one upload spans a dozen events.
  correlationId String  @map("correlation_id")
  /// The event that DIRECTLY caused this one, making the chain a tree.
  causationId   String? @map("causation_id")

  payload  Json
  metadata Json?

  /// Natural key of the fact, built from the thing and never from the clock.
  /// Unique, so a webhook redelivery or a cron re-run records one fact once.
  idempotencyKey String? @unique @map("idempotency_key")

  /// True when this row is being re-delivered from the log rather than
  /// happening for the first time. Consumers that reach a customer refuse to
  /// act on a replay — backfilling a subscriber must never email two years of
  /// notifications.
  isReplay Boolean @default(false) @map("is_replay")

  /// Outbox state: pending | dispatched | failed. Set once the fan-out has
  /// created a delivery row per interested subscriber.
  dispatchState String    @default("pending") @map("dispatch_state")
  dispatchedAt  DateTime? @map("dispatched_at")

  user       User?                   @relation(fields: [subjectUserId], references: [id], onDelete: Cascade)
  deliveries BusinessEventDelivery[]

  // The outbox drain: pending rows, oldest first.
  @@index([dispatchState, recordedAt])
  // "What happened to this customer" — the timeline and DSR export.
  @@index([subjectUserId, occurredAt])
  // Per-aggregate replay, in order.
  @@index([aggregateType, aggregateId, sequence])
  // "Everything in this causal chain".
  @@index([correlationId])
  @@index([name, occurredAt])
  @@map("business_events")
}

/// One event's delivery to one subscriber.
///
/// Separate from the event so a single subscriber failing never blocks another,
/// and so a retry is scoped to the consumer that actually failed rather than
/// re-running the whole fan-out.
model BusinessEventDelivery {
  id            String    @id @default(cuid()) @map("delivery_id")
  eventId       String    @map("event_id")
  /// Subscriber key from the code-side registry.
  subscriber    String
  /// pending | running | succeeded | failed | skipped | dead
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at")
  /// Why a subscriber declined to act — `replay`, `not_applicable`,
  /// `already_applied`. A skip is not a failure and must not read as one.
  skipReason    String?   @map("skip_reason")
  lastError     String?   @map("last_error")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  /// Actions the subscriber performed, for the workflow audit trail.
  actions       Json?

  event BusinessEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// One delivery per subscriber per event — the claim that makes processing
  /// exactly-once, mirroring ProcessedWebhookEvent for Stripe.
  @@unique([eventId, subscriber])
  // The delivery worker: due work, oldest first.
  @@index([status, nextAttemptAt])
  @@index([subscriber, status])
  @@map("business_event_deliveries")
}

/// Per-user delivery preferences that are not per-event.
///
/// One model for customers AND advisors. The two want different DEFAULTS — a
/// customer wants nothing at 03:00, an advisor wants work inside working hours —
/// but they want the same SETTINGS, and a second table would be the same logic
/// twice, differing only in who it applies to. Defaults are derived from the
/// user's role at read time; the stored row is the override.
model UserNotificationSettings {
  userId   String @id @map("user_id")
  /// IANA zone. Quiet hours are meaningless without one, and the product is
  /// Greek-market: Europe/Athens is the honest default, not UTC.
  timezone String @default("Europe/Athens")

  /// Defer non-urgent notifications overnight. ON by default: a push at 03:00
  /// is a reason to uninstall, and a customer should not have to discover the
  /// setting after being woken.
  quietHoursEnabled Boolean @default(true) @map("quiet_hours_enabled")
  /// Local hours, 0–23. Start > end means the window crosses midnight, which is
  /// the normal case.
  quietHoursStart   Int     @default(22) @map("quiet_hours_start")
  quietHoursEnd     Int     @default(8) @map("quiet_hours_end")

  /// Hard cap on notifications per rolling day. Null = the role default.
  /// A runaway cron reaching a customer forty times is worse than the cron.
  /// An explicit 0 is the customer's §9.5 global outbound OFF switch: the
  /// dispatcher records a skip — never a deferral — for every non-transactional
  /// outbound channel, independent of every admin toggle. Only the settings
  /// screen's pause control writes 0. See lib/notifications/cadence.ts.
  maxPerDay Int? @map("max_per_day")

  /// immediate | daily — reserved for digest batching.
  digestMode String @default("immediate") @map("digest_mode")

  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_settings")
}

// ── Automation administration ────────────────────────────────────────────────
//
// Specification: docs/architecture/notification-automation.md §Console

/// One scheduled job, as the operator sees it.
///
/// The schedule itself lives in vercel.json — the platform owns when a cron
/// fires and the app cannot change that. What the app CAN own is whether the
/// job does anything when it does fire, which is what `enabled` is: a pause
/// that works without a redeploy.
///
/// Rows are created on first run rather than seeded, so the list is what
/// actually runs rather than what someone once wrote down.
model JobSchedule {
  name        String   @id
  /// False = the job returns immediately and records a `paused` run. Recorded
  /// rather than silent: "this did not happen because you paused it" is what an
  /// operator needs when a customer asks why nothing arrived.
  enabled     Boolean  @default(true)
  description String?
  changedBy   String?  @map("changed_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  runs JobRun[]

  @@map("job_schedules")
}

/// One execution of one scheduled job.
///
/// Without this the admin console could only render vercel.json back at the
/// operator — a list of cron expressions with no evidence any of them ran. A
/// schedule you cannot observe is a schedule you cannot trust.
model JobRun {
  id         String    @id @default(cuid()) @map("run_id")
  jobName    String    @map("job_name")
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  /// running | succeeded | failed | paused
  status     String    @default("running")
  /// The job's own summary object — whatever it reports about what it did.
  summary    Json?
  error      String?
  /// Wall-clock milliseconds. Null while still running.
  durationMs Int?      @map("duration_ms")
  /// cron | manual — an operator-triggered run is not evidence the schedule works.
  trigger    String    @default("cron")

  schedule JobSchedule @relation(fields: [jobName], references: [name], onDelete: Cascade)

  // "How is this job doing" — newest first.
  @@index([jobName, startedAt])
  // The health view: recent failures across every job.
  @@index([status, startedAt])
  @@map("job_runs")
}

/// Operator override on a BUSINESS event.
///
/// Distinct from NotificationRuleOverride, which governs a NOTIFICATION. This
/// switches the fact itself off at source: with it disabled the event is still
/// recorded — the fact happened and denying it would corrupt the log — but the
/// decision engine takes no actions from it. That is the difference between
/// "stop telling people" and "stop reacting at all".
model BusinessEventOverride {
  id        String   @id @default(cuid()) @map("override_id")
  eventType String   @unique @map("event_type")
  enabled   Boolean  @default(true)
  /// Why an operator switched it off. Shown next to the switch.
  notes     String?  @db.Text
  version   Int      @default(1)
  changedBy String?  @map("changed_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("business_event_overrides")
}

// ── Risk review ──────────────────────────────────────────────────────────────
//
// A review is a HUMAN CHECKPOINT, and that is what makes it different from a
// recalculation. The engine already recomputes continuously and silently on
// every material change; a review is the far rarer moment where we ask the
// customer to look at the result and confirm or correct the life it was
// computed from.
//
// The distinction decides the whole design. If every coverage gap opened a
// review, reviews would become the thing people dismiss without reading — the
// same failure as a list where everything is urgent. Most triggers recalculate;
// only a few are worth interrupting someone for.

model RiskReview {
  id     String @id @default(cuid()) @map("review_id")
  userId String @map("user_id")

  /// Why this review exists — a ReviewTrigger key. Kept because "your annual
  /// review" and "you told us a child was born" are different conversations,
  /// and a review that cannot say why it opened is one the customer distrusts.
  trigger String

  /// open | completed | dismissed | expired | superseded
  status String @default("open")

  /// When the customer should look by. A review with no deadline is a to-do
  /// nobody does.
  dueAt       DateTime  @map("due_at")
  openedAt    DateTime  @default(now()) @map("opened_at")
  completedAt DateTime? @map("completed_at")

  /// The protection score when the review opened, so the customer can be shown
  /// what changed BY reviewing rather than only what is true now.
  scoreAtOpen    Int? @map("score_at_open")
  scoreAtClose   Int? @map("score_at_close")
  /// Open findings at open time — the size of the ask.
  findingsAtOpen Int? @map("findings_at_open")

  /// The risk-profile version this review was raised against, so a stale review
  /// can be recognised rather than shown as current.
  versionAtOpen Int? @map("version_at_open")

  /// What the customer changed while reviewing, for the timeline.
  outcome         String? @db.Text
  /// The event that caused it, when one did.
  causedByEventId String? @map("caused_by_event_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "Does this customer have an open review" — the dashboard card and the
  // cooldown check both ask this.
  @@index([userId, status])
  // The scan: reviews that are due, and reviews that have gone stale.
  @@index([status, dueAt])
  @@map("risk_reviews")
}

/// An operator-controlled feature flag.
///
/// Flags are NOT invented here — every row corresponds to a key already
/// declared in lib/flags/registry.ts, which in turn corresponds to an
/// environment variable this product has been reading all along
/// (FF_AI_FAILOVER_OPENAI, ENFORCE_EMAIL_VERIFICATION, EXTRACTION_CITATIONS, …).
///
/// The point of the table is the thing the env var cannot do: change without a
/// redeploy. Precedence is DB row → environment variable → the default declared
/// in code, so an unreadable database or a missing row leaves the product
/// behaving exactly as it shipped. A row for an unknown key is inert, never a
/// crash — the same contract notification rule overrides already follow.
model FeatureFlag {
  id  String @id @default(cuid()) @map("flag_id")
  /// Registry key, e.g. "ai.failover_openai". Unknown keys are ignored on read.
  key String @unique

  /// The kill switch. Null means "no opinion — fall through to the env var".
  enabled Boolean?

  /// Audience for a staged rollout, mirroring the canary vocabulary the AI
  /// remediation path already uses: off | internal | 10 | 50 | 100.
  /// Null falls through to the env var in the same way.
  rollout String?

  /// Why this was changed. Operator input, shown in the version history.
  notes String? @db.Text

  version   Int      @default(1)
  changedBy String?  @map("changed_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  revisions FeatureFlagRevision[]

  @@map("feature_flags")
}

/// Append-only history for FeatureFlag, matching NotificationTemplateRevision
/// and NotificationRuleRevision. A flag flip is an operational act on live
/// customer traffic; "who turned this on, when, and why" has to survive the
/// next edit.
model FeatureFlagRevision {
  id             String   @id @default(cuid()) @map("revision_id")
  flagId         String   @map("flag_id")
  version        Int
  snapshot       Json
  changes        Json
  changedBy      String   @map("changed_by")
  changedByEmail String   @map("changed_by_email")
  createdAt      DateTime @default(now()) @map("created_at")

  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId, createdAt])
  @@map("feature_flag_revisions")
}
