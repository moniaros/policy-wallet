model Opportunity {
  id                  String    @id @default(cuid()) @map("opportunity_id")
  relationshipId      String    @map("relationship_id")
  policyId            String?   @map("policy_id")
  gapInstanceId       String?   @map("gap_instance_id")
  status              String    @default("open")
  nextActionAt        DateTime? @map("next_action_at")
  notes               String?
  ownerAgentUserId    String    @map("owner_agent_user_id")
  estimatedPremium    Decimal?  @map("estimated_premium")
  estimatedCommission Decimal?  @map("estimated_commission")
  quotedPremium       Decimal?  @map("quoted_premium")
  wonPremium          Decimal?  @map("won_premium")
  currency            String    @default("EUR")
  lineOfBusiness      String?   @map("line_of_business")
  /// MEDIC qualification snapshot (blueprint §E): stakeholders[], criteria[],
  /// decisionProcess, pain, metrics — JSON per the acordData/preferences
  /// precedent. Structured detail lives here; the scalar below is for sort.
  medic               Json?
  /// Transparent 0-100 qualification score (calculateMedicScore) — a sortable/
  /// filterable scalar mirroring ProtectionScore.overallScore.
  medicScore          Int?      @map("medic_score")
  /// Staleness/audit stamp for the qualification snapshot.
  medicUpdatedAt      DateTime? @map("medic_updated_at")

  // Structured close outcome, mirroring PolicyRenewal's proven shape. `status`
  // alone said a deal was lost but never why, so loss reasons were unanalysable.
  // `outcomeAt` is the IMMUTABLE close date — trend/cohort reporting must bucket
  // on it, never on `updatedAt` (which any note edit or reassignment bumps).
  outcome      String? // see OPPORTUNITY_*_OUTCOMES in types/enums.ts
  outcomeNotes String?   @map("outcome_notes")
  outcomeAt    DateTime? @map("outcome_at")

  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  gapInstance          GapInstance?              @relation(fields: [gapInstanceId], references: [id])
  owner                User                      @relation(fields: [ownerAgentUserId], references: [id])
  policy               Policy?                   @relation(fields: [policyId], references: [id])
  relationship         CustomerRelationship      @relation(fields: [relationshipId], references: [id])
  collaborationThreads CollaborationThread[]
  stageHistory         OpportunityStageHistory[]

  @@index([relationshipId])
  @@index([policyId])
  @@index([ownerAgentUserId])
  @@index([status])
  // Dashboard, priorities and scoring all filter by (owner, status); the two
  // single-column indexes force a scan-and-filter on the larger side.
  @@index([ownerAgentUserId, status])
  // Pipeline sorted MEDIC-score-descending per owner (blueprint §F /customers).
  @@index([ownerAgentUserId, medicScore])
  // Won/lost reporting filters by owner and buckets by close date.
  @@index([ownerAgentUserId, outcomeAt])
  @@map("opportunities")
}

/// Append-only stage-transition log.
///
/// `Opportunity.status` is a single mutable column, so every transition used to
/// overwrite the previous one: `open → quoted → lost` and `open → lost` were
/// indistinguishable afterwards, making time-in-stage, funnel velocity and
/// forecast accuracy impossible to compute (and unbackfillable, since the data
/// was never written). One row per transition fixes that going forward.
///
/// This is the first append-only table in the schema — it grows ~5-15 rows per
/// opportunity, so it is indexed for the two reads it serves and nothing else.
model OpportunityStageHistory {
  id              String   @id @default(cuid()) @map("stage_history_id")
  opportunityId   String   @map("opportunity_id")
  /// null when the opportunity row was created (no prior stage).
  fromStatus      String?  @map("from_status")
  toStatus        String   @map("to_status")
  /// null for system-driven transitions (cross-sell engine, cron).
  changedByUserId String?  @map("changed_by_user_id")
  /// Close reason, set only on transitions into a terminal stage.
  outcome         String?
  note            String?
  changedAt       DateTime @default(now()) @map("changed_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  // Per-deal timeline reads walk one opportunity in order.
  @@index([opportunityId, changedAt])
  // Funnel/velocity aggregates scan transitions into a stage over a window.
  @@index([toStatus, changedAt])
  @@map("opportunity_stage_history")
}

