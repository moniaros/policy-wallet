model PolicyAnalysisRun {
  id                      String            @id @default(cuid()) @map("analysis_run_id")
  policyId                String            @map("policy_id")
  userId                  String            @map("user_id")
  provider                String
  model                   String
  status                  AnalysisRunStatus @default(queued)
  priority                Int               @default(0) @map("priority") // 0=standard, 1=plus, 2=pro (higher = sooner)
  runAttempt              Int               @default(1) @map("run_attempt")
  overallSuccessPct       Int?              @map("overall_success_pct")
  estimatedTokens         Int?              @map("estimated_tokens")
  actualInputTokens       Int?              @map("actual_input_tokens")
  actualOutputTokens      Int?              @map("actual_output_tokens")
  actualTotalTokens       Int?              @map("actual_total_tokens")
  blockedReason           String?           @map("blocked_reason")
  failureCode             String?           @map("failure_code")
  failureMessage          String?           @map("failure_message")
  remediationSummary      Json?             @map("remediation_summary")
  resultJson              Json?             @map("result_json")
  /// Which rules this run attempted (B0.2): recorded at creation from the
  /// declared branch (`phase: planned`) and again once evaluated (`phase:
  /// evaluated`, final branch, decided slugs), with the catalogue version. It
  /// survives a run that fails before evaluation.
  attemptedRules          Json?             @map("attempted_rules")
  executionLeaseId        String?           @map("execution_lease_id")
  executionLeaseExpiresAt DateTime?         @map("execution_lease_expires_at")
  leaseHeartbeatAt        DateTime?         @map("lease_heartbeat_at")
  startedAt               DateTime?         @map("started_at")
  finishedAt              DateTime?         @map("finished_at")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  policy Policy               @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps  PolicyAnalysisStep[]
  gapInstances GapInstance[]

  @@index([policyId, createdAt])
  @@index([userId, createdAt])
  @@index([status, executionLeaseExpiresAt])
  @@index([status, priority, createdAt])
  @@map("policy_analysis_runs")
}

