generator client {
  provider        = "prisma-client-js"
  // `omit` (GA in Prisma 6) — lib/db.ts omits `User.password` from every read
  // unless a query names it (PW-BRIDGE-01 A-01b).
  previewFeatures = ["omitApi"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AnalysisRunStatus {
  queued
  running
  completed
  completed_with_warnings
  failed
  blocked
}

enum AnalysisStepStatus {
  pending
  running
  completed
  failed
  retrying
  skipped
}

enum GapValidationState {
  probable
  confirmed
  validated

  @@map("gap_validation_state")
}

enum ConsentType {
  cookie
  terms
  privacy
  ai_processing
}

enum DataExportStatus {
  requested
  processing
  completed
  failed
  expired
}

enum DeletionRequestStatus {
  requested
  in_review
  approved
  processing
  completed
  rejected
  failed
}

model User {
  id                              String                     @id @default(cuid()) @map("user_id")
  name                            String?
  email                           String                     @unique
  emailVerified                   DateTime?
  image                           String?
  preferredLanguage               String                     @default("el") @map("preferred_language")
  roles                           String                     @default("policyholder")
  createdAt                       DateTime                   @default(now()) @map("created_at")
  updatedAt                       DateTime                   @updatedAt @map("updated_at")
  lastActiveAt                    DateTime?                  @map("last_active_at")
  password                        String?
  phoneNumber                     String?                    @map("phone_number")
  taxId                           String?                    @map("tax_id")
  /// The customer has NO email address. `email` is non-null and unique, so an
  /// agent-created customer without one (owner decision D3: allowed, with
  /// ΑΦΜ + Greek mobile as identity) carries a synthetic, non-deliverable
  /// address built by lib/identity/synthetic-email.ts. Every email sender
  /// refuses such an address; the invite flow refuses such a customer. Cleared
  /// when a real address replaces the synthetic one (updateCustomerContact).
  contactEmailMissing             Boolean                    @default(false) @map("contact_email_missing")
  /// Legacy single FCM token, superseded by `pushDevices`. Read-only: kept so
  /// any token registered before the Web Push cutover can still be reached, and
  /// so erasure keeps clearing it. Nothing writes it any more.
  pushToken                       String?                    @map("push_token")
  stripeCustomerId                String?                    @unique @map("stripe_customer_id")
  termsVersionAccepted            String?                    @map("terms_version_accepted")
  privacyVersionAccepted          String?                    @map("privacy_version_accepted")
  cookieConsentVersion            String?                    @map("cookie_consent_version")
  consentUpdatedAt                DateTime?                  @map("consent_updated_at")
  consentLocale                   String?                    @map("consent_locale")
  aiProcessingConsentVersion      String?                    @map("ai_processing_consent_version")
  trialAnalysisUsedAt             DateTime?                  @map("trial_analysis_used_at")
  grantsReceived                  AccessGrant[]              @relation("Grantee")
  grantsGiven                     AccessGrant[]              @relation("Granter")
  accounts                        Account[]
  activeSessions                  ActiveSession[]
  adminProfile                    AdminUser?
  agentProfile                    AgentProfile?
  creditTransactions              CreditTransaction[]
  customerRelationshipsAsAgent    CustomerRelationship[]     @relation("Agent")
  customerRelationshipsAsCustomer CustomerRelationship[]     @relation("Customer")
  entitlementUsages               EntitlementUsage[]
  invitesReceived                 Invite[]                   @relation("Invitee")
  invitesSent                     Invite[]                   @relation("Inviter")
  invoices                        Invoice[]
  notifications                   NotificationEvent[]
  notificationPreferences         NotificationPreference[]
  opportunitiesOwned              Opportunity[]
  paymentMethods                  PaymentMethod[]
  pushDevices                     PushDevice[]
  businessEvents                  BusinessEvent[]
  notificationSettings            UserNotificationSettings?
  riskReviews                     RiskReview[]
  policiesCreated                 Policy[]                   @relation("Creator")
  policiesOwned                   Policy[]                   @relation("Owner")
  documentsUploaded               PolicyDocument[]
  policyholderProfile             PolicyholderProfile?
  protectionProfile               ProtectionProfile?
  questionnairesSent              QuestionnaireInstance[]    @relation("Sender")
  questionnairesReceived          QuestionnaireInstance[]    @relation("Receiver")
  questionnaireResponses          QuestionnaireResponse[]
  referralsReceived               Referral[]                 @relation("Referred")
  referralsMade                   Referral[]                 @relation("Referrer")
  securityEvents                  SecurityEvent[]
  sessions                        Session[]
  subscriptions                   Subscription[]
  tasksReceived                   UserTask[]                 @relation("TaskRecipient")
  tasksCreated                    UserTask[]                 @relation("TaskCreator")
  tokenUsage                      TokenUsage[]               @relation("TokenUsage")
  tokenBalance                    TokenBalance?              @relation("TokenBalance")
  tokenPurchases                  TokenPurchase[]            @relation("TokenPurchases")
  reportUnlockPurchases           ReportUnlockPurchase[]     @relation("ReportUnlockPurchases")
  mergeRequestsRaised             PolicyMergeRequest[]       @relation("MergeRequester")
  mergeRequestsToApprove          PolicyMergeRequest[]       @relation("MergeApprover")
  monthlyTokenUsage               MonthlyTokenUsage[]        @relation("MonthlyTokenUsage")
  policyAnalysisRuns              PolicyAnalysisRun[]
  collaborationThreadsCreated     CollaborationThread[]      @relation("CollaborationThreadCreatedBy")
  collaborationThreadsAssigned    CollaborationThread[]      @relation("CollaborationThreadAssignedTo")
  collaborationMessages           CollaborationMessage[]
  collaborationActionsAssigned    CollaborationAction[]      @relation("CollaborationActionAssignee")
  collaborationParticipants       CollaborationParticipant[]
  policyRenewals                  PolicyRenewal[]
  tenantMemberships               TenantMembership[]
  passkeyCredentials              PasskeyCredential[]
  webAuthnChallenges              WebAuthnChallenge[]
  consents                        ConsentAudit[]
  dataExportRequests              DataExportRequest[]
  deletionRequests                DeletionRequest[]
  documentRequestsCreated         DocumentRequest[]
  proposalsCreated                Proposal[]
  GapInstance                     GapInstance[]
  protectionScore                 ProtectionScore?
  recommendations                 RecommendationInstance[]
  lifeEventInstances              LifeEventInstance[]
  riskProfileVersions             RiskProfileVersion[]

  @@index([taxId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AgentProfile {
  id                 String  @id @default(cuid()) @map("profile_id")
  userId             String  @unique @map("user_id")
  verificationStatus String  @default("pending") @map("verification_status")
  agencyName         String? @map("agency_name")
  licenseNumber      String? @map("license_number")

  // Branding & Profile
  logoUrl    String?
  brandColor String? @default("#10b981")
  website    String?
  phone      String?
  documents  Json? // [{ type: "license", url: "..." }]

  // Commission rates per LoB: { "motor": 15, "health": 20, ... } (percentage)
  commissionRates Json? @map("commission_rates")

  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  submittedAt           DateTime  @default(now()) @map("submitted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_profiles")
}

model PolicyholderProfile {
  id          String @id @default(cuid()) @map("profile_id")
  userId      String @unique @map("user_id")
  preferences Json?

  // Risk Profile Fields
  maritalStatus    String?  @map("marital_status") // e.g. 'single', 'married'
  dependentsCount  Int      @default(0) @map("dependents_count")
  employmentStatus String?  @map("employment_status") // e.g. 'employed', 'self_employed', 'retired'
  ownsHome         Boolean  @default(false) @map("owns_home")
  mortgageAmount   Decimal? @map("mortgage_amount")
  hasPets          Boolean  @default(false) @map("has_pets")
  /// How many, so the exposure can be stated in the customer's own numbers
  /// ("two dogs") rather than as a boolean ("you have pets").
  petsCount        Int?     @map("pets_count")
  vehiclesCount    Int      @default(0) @map("vehicles_count")

  // Enhanced Risk Fields (Gap Detection Engine)
  dateOfBirth       DateTime? @map("date_of_birth")
  annualIncome      Decimal?  @map("annual_income")
  occupation        String? // e.g. 'office_worker', 'manual_labor', 'freelancer'
  riskTolerance     String?   @map("risk_tolerance") // 'conservative', 'moderate', 'aggressive'
  hasLoans          Boolean   @default(false) @map("has_loans")
  loanAmount        Decimal?  @map("loan_amount")
  travelsFrequently Boolean   @default(false) @map("travels_frequently")
  smokingStatus     String?   @map("smoking_status") // 'non_smoker', 'smoker', 'former_smoker'
  lifeEvents        Json?     @map("life_events") // [{type: 'new_baby', date: '2026-03'}]

  // ── Life Context Risk Assessment fields ───────────────────────────────────
  // Contextual factors the risk catalog conditions on. A risk whose deciding
  // factors are unknown is reported as `needs_review`, never as a gap — see
  // lib/services/gap-engine/life-context.ts.
  childrenCount      Int      @default(0) @map("children_count")
  residenceType      String?  @map("residence_type") // 'owned' | 'rented' | 'family' | 'company'
  propertiesOwned    Int?     @map("properties_owned")
  rentsOutProperty   Boolean  @default(false) @map("rents_out_property")
  ownsBoat           Boolean  @default(false) @map("owns_boat")
  ownsBusiness       Boolean  @default(false) @map("owns_business")
  businessEmployees  Int      @default(0) @map("business_employees")
  savingsAmount      Decimal? @map("savings_amount")
  valuablesValue     Decimal? @map("valuables_value")
  activities         Json?    @map("activities") // string[] — HIGH_RISK_ACTIVITIES ids
  cyberExposure      String?  @map("cyber_exposure") // 'low' | 'moderate' | 'high'
  retirementPlanning Boolean  @default(false) @map("retirement_planning")
  /// Acts as the manager (διαχειριστής) of a block of flats. A distinctly Greek
  /// exposure: the role is unpaid, usually rotates between residents, and
  /// carries personal liability for the common areas — lifts, stairwells, the
  /// pipework behind them. No other column implies it, because it applies to
  /// tenants as readily as to owners.
  isBuildingManager  Boolean  @default(false) @map("is_building_manager")
  /// Lines the customer holds OUTSIDE PolicyWallet (bank-assigned borrower
  /// cover, employer group scheme). Without this the engine reads "not in the
  /// wallet" as "does not exist" and manufactures a gap against a real policy.
  coverHeldElsewhere Json?    @map("cover_held_elsewhere") // string[] of branch ids
  /// Columns the customer has actually been asked and answered. The risk
  /// columns are NOT NULL with defaults, so without this record an untouched
  /// profile is byte-identical to one whose owner answered "no" to everything.
  answeredFields     Json?    @map("answered_fields") // string[] of column names
  /// How far the household leans on this person's income — 'primary' |
  /// 'shared' | 'minor'. A plain fact the importance table reads; deliberately
  /// NOT a risk-catalogue factor (the factor vocabulary is the engine's own).
  incomeDependency   String?  @map("income_dependency")
  /// Who wrote each fact, and how precisely: keyed by column name,
  /// `{ source, precision, at }` (lib/protection/evidence.ts). Written only
  /// through applyFactWrites (lib/services/protection-profile/fact-writes.ts),
  /// which is what lets an exact answer replace a coarse floor and never the
  /// reverse. `answeredFields` stays the derived union the engine reads; rows
  /// written before this column keep their knownness unchanged (no backfill).
  factProvenance     Json?    @map("fact_provenance")

  // Health & Lifestyle Risk Fields
  gender               String? @map("gender") // 'male', 'female', 'prefer_not_to_say'
  heightCm             Int?    @map("height_cm") // used for BMI
  weightKg             Int?    @map("weight_kg") // used for BMI
  chronicConditions    Json?   @map("chronic_conditions") // string[] e.g. ['diabetes', 'hypertension']
  familyMedicalHistory Json?   @map("family_medical_history") // string[] e.g. ['heart_disease', 'cancer']
  drivingRecord        String? @map("driving_record") // 'clean', 'minor_violations', 'major_violations', 'accidents'
  activityLevel        String? @map("activity_level") // 'sedentary', 'moderate', 'active', 'very_active'

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("policyholder_profiles")
}

model Insurer {
  id                         String   @id @default(cuid()) @map("insurer_id")
  name                       String   @unique // Greek commercial name; Policy.insurerName references it as a free string
  slug                       String?  @unique // reference-dataset id (prisma/greek-insurers.json); NULL for admin-created rows
  nameEn                     String?  @map("name_en")
  legalNameEl                String?  @map("legal_name_el")
  status                     String   @default("active") // active | merged | rebranded | branch | run_off (INSURER_STATUS_VALUES)
  groupParent                String?  @map("group_parent")
  logoUrl                    String?  @map("logo_url")
  website                    String?
  callCenter                 String?  @map("call_center") // free text incl. short codes (e.g. "18189")
  claimsPhone                String?  @map("claims_phone")
  roadsidePhone              String?  @map("roadside_phone") // may embed two numbers (domestic / from abroad)
  paymentGatewayUrl          String?  @map("payment_gateway_url")
  contactEmail               String?  @map("contact_email")
  hqAddress                  Json?    @map("hq_address") // { street, city, postalCode, country }
  roadsideAssistanceProvider String?  @map("roadside_assistance_provider")
  linesOfBusiness            String[] @default([]) @map("lines_of_business") // INSURER_LOB_VALUES vocabulary
  fieldConfidence            Json?    @map("field_confidence") // per-field: verified_2026|stale|unverified|not_applicable|admin_edited
  notes                      String?
  isActive                   Boolean  @default(true) @map("is_active")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("insurers")
}

model InsuranceType {
  id        String   @id @default(cuid()) @map("type_id")
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("insurance_types")
}

model Tenant {
  id         String             @id @default(cuid()) @map("tenant_id")
  name       String
  type       String             @default("agency") // agency | personal
  logoUrl    String?            @map("logo_url")
  brandColor String?            @default("#10b981") @map("brand_color")
  website    String?
  phone      String?
  address    String?
  taxId      String?            @map("tax_id") // ΑΦΜ for Greek agencies
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  members    TenantMembership[]

  @@map("tenants")
}

model TenantMembership {
  id        String    @id @default(cuid()) @map("membership_id")
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  role      String    @default("member") // owner | manager | member
  status    String    @default("active") // active | suspended | invited
  invitedBy String?   @map("invited_by")
  invitedAt DateTime? @map("invited_at")
  joinedAt  DateTime? @map("joined_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model Policy {
  id                      String                 @id @default(cuid()) @map("policy_id")
  ownerUserId             String                 @map("owner_user_id")
  createdByUserId         String                 @map("created_by_user_id")
  policyNumber            String                 @map("policy_number")
  insurerName             String                 @map("insurer_name")
  lineOfBusiness          String                 @map("line_of_business")
  startDate               DateTime               @map("start_date")
  endDate                 DateTime               @map("end_date")
  // Denormalized real coverage end date (resolvePolicyLifecycle: renewal
  // history → extracted envelope → endDate column). Lets active-policy counts
  // filter/count in SQL instead of deserializing acordData per row. NULL =
  // "unknown duration" (unreadable/absent expiry) — counts as coverage.
  coverageEndDate         DateTime?              @map("coverage_end_date")
  status                  String
  premiumAmount           Decimal?               @map("premium_amount")
  premiumCurrency         String?                @default("EUR") @map("premium_currency")
  coverageSummary         String?                @map("coverage_summary")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  acordData               Json?                  @map("acord_data")
  lastAnalyzedAt          DateTime?              @map("last_analyzed_at")
  // One-off €3 gap-report unlock (free tier); survives re-analysis.
  reportUnlockedAt        DateTime?              @map("report_unlocked_at")
  gapInstances            GapInstance[]
  opportunities           Opportunity[]
  creator                 User                   @relation("Creator", fields: [createdByUserId], references: [id])
  owner                   User                   @relation("Owner", fields: [ownerUserId], references: [id])
  documents               PolicyDocument[]
  tokenUsages             TokenUsage[]           @relation("PolicyTokenUsage")
  analysisRuns            PolicyAnalysisRun[]
  collaborationThreads    CollaborationThread[]
  renewals                PolicyRenewal[]
  reportUnlocks           ReportUnlockPurchase[]
  mergeRequestsAsExisting PolicyMergeRequest[]   @relation("MergeExisting")
  mergeRequestsAsIncoming PolicyMergeRequest[]   @relation("MergeIncoming")

  @@index([ownerUserId])
  @@index([createdByUserId])
  @@index([endDate])
  @@index([coverageEndDate])
  @@map("policies")
}

model PolicyDocument {
  id               String    @id @default(cuid()) @map("document_id")
  policyId         String    @map("policy_id")
  fileUrl          String    @map("file_url")
  /// A GENERATED label, never the user's own file name — see
  /// lib/wallet/document-label.ts. The name a customer gave the file is kept
  /// nowhere: `LIFE_POLICY.pdf` attached to a health policy disclosed a life
  /// component before anyone opened the document. Display only, and never a
  /// storage key.
  fileName         String    @map("file_name")
  fileSize         Int       @map("file_size")
  source           String
  processingStatus String    @default("pending") @map("processing_status")
  uploadedByUserId String    @map("uploaded_by_user_id")
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  documentHash     String?   @map("document_hash")
  extractionCache  Json?     @map("extraction_cache")
  extractedAt      DateTime? @map("extracted_at")

  /// Storage bucket holding the object. Null on rows predating this column —
  /// those are resolved by parsing fileUrl, which is exactly the fragility this
  /// removes: a project-host change or a signed-URL variant makes the URL
  /// unparseable, and the document becomes unreachable with no way back.
  storageBucket   String?         @map("storage_bucket")
  /// Object key WITHIN the bucket. The authoritative locator.
  storageKey      String?         @map("storage_key")
  /// Which storage system holds it. One value today; named so a second one can
  /// be added without guessing at existing rows.
  storageProvider String?         @default("supabase") @map("storage_provider")
  /// Canonical MIME type, derived from verified CONTENT at upload time — not
  /// from the client's claim and not from the filename extension.
  mimeType        String?         @map("mime_type")
  /// What kind of document this is, from the AI classifier (see
  /// lib/services/ai/document-kind.ts): policy_schedule, terms_and_conditions,
  /// renewal_notice, forms, certificate, invoice, other.
  documentKind    String?         @map("document_kind")
  /// The document gate's verdict (lib/ingestion/document-gate.ts): 'validated'
  /// | 'requires_review' | 'rejected'. NULL = uploaded before the gate existed;
  /// the orchestrator validates such rows lazily before its first model call.
  validationStatus String?        @map("validation_status")
  /// The full DocumentValidationResult: type, confidences, branches, evidence. No text, no filename.
  validationJson   Json?          @map("validation_json")
  validatedAt      DateTime?      @map("validated_at")
  /// The period this DOCUMENT covers, as distinct from the policy's period.
  ///
  /// A Greek policy is a chain: the πρωτασφαλιστήριο carries the full terms and
  /// every later year issues an ανανεωτήριο that changes a few things and is
  /// silent about the rest. Ordering that chain by `uploadedAt` orders it by
  /// when someone got round to uploading, which is not the same thing and is
  /// wrong exactly when a customer back-fills an old renewal.
  ///
  /// Null on every row predating this column, and on documents that state no
  /// period of their own (a terms booklet, an invoice).
  effectiveFrom   DateTime?       @map("effective_from")
  effectiveTo     DateTime?       @map("effective_to")
  /// Monotonic per policy+document lineage. Everything is version 1 today; the
  /// column exists so replacing a document can supersede rather than destroy,
  /// without restructuring storage.
  version         Int             @default(1)
  /// Set when a newer version replaces this one, so history is preserved and
  /// the current document is unambiguous.
  supersededById  String?         @unique @map("superseded_by_id")
  supersededBy    PolicyDocument? @relation("DocumentVersion", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes      PolicyDocument? @relation("DocumentVersion")

  policy   Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploadedByUserId], references: [id])

  @@index([policyId])
  @@index([uploadedByUserId])
  @@index([documentHash])
  @@index([storageBucket, storageKey])
  @@map("policy_documents")
}

model GapDefinition {
  id              String  @id @default(cuid()) @map("gap_definition_id")
  scope           String  @default("document") // 'document' or 'portfolio'
  slug            String  @unique
  name            String
  title           String
  description     String
  lineOfBusiness  String  @map("line_of_business")
  severity        String
  defaultSeverity String  @map("default_severity")
  ruleId          String  @map("rule_id")
  detectionLogic  Json    @map("detection_logic")
  isActive        Boolean @default(true) @map("is_active")

  /// Gate 3b. Detection is a question of fact and is authored in code; SEVERITY is
  /// an underwriting judgement and is not. `severity` above is a PROPOSAL until an
  /// underwriter agrees with it, and these three columns are where that agreement
  /// is recorded — per definition, because sign-off arrives a branch at a time and
  /// a single global boolean could only ever say "none of it" or "all of it",
  /// which in practice meant none of it, indefinitely.
  /// Null `severityValidatedAt` = not validated. The UI shows the caveat on
  /// exactly those, so a validated rule stops apologising and an unvalidated one
  /// cannot quietly stop.
  severityValidatedAt DateTime? @map("severity_validated_at")
  /// Who agreed — a named person with the standing to. Not a deploying developer.
  severityValidatedBy String?   @map("severity_validated_by")
  /// Why this severity and not the one next to it. The part that is worth having
  /// in a year, when someone asks whether "high" was ever thought about.
  severityRationale   String?   @map("severity_rationale")

  // L4: Versioning — increment on every admin update for audit / rollback
  version   Int           @default(1)
  changedAt DateTime?     @map("changed_at")
  changedBy String?       @map("changed_by")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  instances GapInstance[]

  // Gap detection loads active definitions per line of business.
  @@index([lineOfBusiness, isActive])
  @@map("gap_definitions")
}

model GapInstance {
  id                   String                   @id @default(cuid()) @map("gap_instance_id")
  policyId             String?                  @map("policy_id")
  userId               String?                  @map("user_id")
  gapDefinitionId      String                   @map("gap_definition_id")
  severity             String
  status               String                   @default("open")
  aiExplanation        String?                  @map("ai_explanation")
  aiSuggestion         String?                  @map("ai_suggestion")
  detectedAt           DateTime                 @default(now()) @map("detected_at")
  resolvedAt           DateTime?                @map("resolved_at")
  aiExplanationEl      String?                  @map("ai_explanation_el")
  aiSuggestionEl       String?                  @map("ai_suggestion_el")
  /// Evidence ladder (MEDIC blueprint §C): probable = AI-detected, confirmed =
  /// advisor agrees, validated = documented recommendation. Makes "gap
  /// detection" honest and gates advisor-ready cross-sell.
  validationState      GapValidationState       @default(probable) @map("validation_state")
  /// PROVENANCE. Which rule decided this gap, what it read, and under which
  /// engine version. Detection and severity are rule decisions; a finding a
  /// human cannot re-derive is an assertion, not an analysis.
  ruleId               String?                  @map("rule_id")
  ruleInputs           Json?                    @map("rule_inputs")
  engineVersion        String?                  @map("engine_version")
  /// RUN PROVENANCE (B0, PW-TRANSPARENCY-02). Which analysis run produced this
  /// row, for which branch, against which catalogue version. A later run never
  /// deletes or reactivates a row: it SUPERSEDES the policy's live rows (prior
  /// status kept) and writes its own. One writer: lib/gaps/gap-instance-writer.ts.
  analysisRunId        String                   @map("analysis_run_id")
  lineOfBusiness       String                   @map("line_of_business")
  catalogueVersion     String?                  @map("catalogue_version")
  supersededAt         DateTime?                @map("superseded_at")
  supersededByRunId    String?                  @map("superseded_by_run_id")
  priorStatus          String?                  @map("prior_status")
  definition           GapDefinition            @relation(fields: [gapDefinitionId], references: [id])
  analysisRun          PolicyAnalysisRun        @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  policy               Policy?                  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user                 User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities        Opportunity[]
  collaborationThreads CollaborationThread[]
  recommendations      RecommendationInstance[]

  @@index([policyId])
  @@index([status])
  // Profile-level gaps and the engine's OR query filter by (userId, status).
  @@index([userId, status])
  // Agent gap views filter by a policy set + status (dashboard, insights, portal).
  @@index([policyId, status])
  @@index([analysisRunId])
  // The writer supersedes the policy's LIVE rows (supersededAt null); readers of
  // current findings filter the same way. A partial unique index
  // (gap_instances_policy_definition_current_unique, raw SQL in the B0 migration)
  // keeps one current row per (policy, definition) while history accumulates.
  @@index([policyId, supersededAt])
  @@map("gap_instances")
}

model CustomerRelationship {
  id                     String                  @id @default(cuid()) @map("relationship_id")
  agentUserId            String                  @map("agent_user_id")
  policyholderUserId     String                  @map("policyholder_user_id")
  status                 String                  @default("pending_activation")
  activationStatus       String                  @default("no_policies") @map("activation_status")
  createdAt              DateTime                @default(now()) @map("created_at")
  lastInteractionAt      DateTime?               @map("last_interaction_at")
  /// The customer's own decision to let this advisor see THAT policies exist
  /// outside what they shared — a count, never an identity. Default false: the
  /// platform discloses nothing on its own (halt H-B2). Only the policyholder
  /// may set it, and only for their own relationship.
  unsharedCountDisclosed Boolean                 @default(false) @map("unshared_count_disclosed")
  agent                  User                    @relation("Agent", fields: [agentUserId], references: [id])
  customer               User                    @relation("Customer", fields: [policyholderUserId], references: [id])
  opportunities          Opportunity[]
  questionnaireInstances QuestionnaireInstance[]
  collaborationThreads   CollaborationThread[]
  documentRequests       DocumentRequest[]
  proposals              Proposal[]

  @@unique([agentUserId, policyholderUserId])
  // Every B2C page looks up the relationship by policyholder; the unique index
  // above leads with agentUserId and cannot serve it.
  @@index([policyholderUserId, status])
  // Agent customer list sorts by last interaction; priorities/summary filter by
  // (agentUserId, status). The unique index serves only agentUserId equality.
  @@index([agentUserId, lastInteractionAt])
  @@index([agentUserId, status])
  @@map("customer_relationships")
}

model AccessGrant {
  id            String    @id @default(cuid()) @map("grant_id")
  granterUserId String    @map("granter_user_id")
  granteeUserId String    @map("grantee_user_id")
  scope         String
  permissions   String
  status        String    @default("active")
  grantedAt     DateTime  @default(now()) @map("granted_at")
  revokedAt     DateTime? @map("revoked_at")
  grantee       User      @relation("Grantee", fields: [granteeUserId], references: [id])
  granter       User      @relation("Granter", fields: [granterUserId], references: [id])

  // Hot path: getGrantedPolicyIds / getPolicyAccess filter by
  // granteeUserId + status + scope on every non-owner policy read and every
  // agent-visibility query. Without this the table was full-scanned each time.
  @@index([granteeUserId, status, scope])
  // Granter-side lookups (share/revoke paths).
  @@index([granterUserId])
  @@map("access_grants")
}

model Invite {
  id                   String    @id @default(cuid()) @map("invite_id")
  inviterUserId        String    @map("inviter_user_id")
  inviteeEmail         String    @map("invitee_email")
  inviteeUserId        String?   @map("invitee_user_id")
  inviteType           String    @map("invite_type")
  relationshipType     String?   @map("relationship_type")
  scope                String?
  requestedPermissions String?   @map("requested_permissions")
  token                String    @unique
  expiresAt            DateTime  @map("expires_at")
  consumedAt           DateTime? @map("consumed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  invitee              User?     @relation("Invitee", fields: [inviteeUserId], references: [id])
  inviter              User      @relation("Inviter", fields: [inviterUserId], references: [id])

  // Agent invite lists and the profile timeline filter by inviter (and
  // inviter+email). Previously only `token` was indexed — every "my invites"
  // query full-scanned the table.
  @@index([inviterUserId, inviteeEmail])
