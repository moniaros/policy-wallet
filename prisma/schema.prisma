  policyEndDate    DateTime @map("policy_end_date")
  daysBeforeExpiry Int      @map("days_before_expiry")

  // Status tracking: pending → contacted → renewed / lapsed / cancelled
  status       String    @default("pending")
  outcome      String? // renewed_same_insurer | renewed_different_insurer | lapsed | cancelled
  outcomeNotes String?   @map("outcome_notes")
  outcomeAt    DateTime? @map("outcome_at")

  // Notification tracking
  remindersSent  Json      @default("[]") @map("reminders_sent") // array of { milestone: number, sentAt: string }
  lastReminderAt DateTime? @map("last_reminder_at")

  // Linked records
  taskId        String? @map("task_id")
  opportunityId String? @map("opportunity_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  owner  User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([policyId, policyEndDate])
  @@index([ownerUserId])
  @@index([agentUserId])
  @@index([status])
  @@index([policyEndDate])
  @@map("policy_renewals")
}

