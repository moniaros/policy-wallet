## 📊 Usage Tracking Implementation

### **Database Schema**

```sql
-- Token usage tracking table
CREATE TABLE token_usage (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(id),
  operation_type VARCHAR(50) NOT NULL, -- 'policy_analysis', 'gap_detection', 'qa_session', etc.
  policy_id UUID REFERENCES policies(id),
  input_tokens INTEGER NOT NULL,
  output_tokens INTEGER NOT NULL,
  total_tokens INTEGER GENERATED ALWAYS AS (input_tokens + output_tokens) STORED,
  cost_eur DECIMAL(10, 6) NOT NULL,
  model VARCHAR(50) NOT NULL, -- 'gemini-2.0-flash'
  created_at TIMESTAMP DEFAULT NOW()
);

-- Token balance table (for on-demand purchases)
CREATE TABLE token_balance (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL UNIQUE REFERENCES users(id),
  purchased_tokens BIGINT DEFAULT 0,
  used_tokens BIGINT DEFAULT 0,
  remaining_tokens BIGINT GENERATED ALWAYS AS (purchased_tokens - used_tokens) STORED,
  last_purchase_at TIMESTAMP,
  created_at TIMESTAMP DEFAULT NOW(),
  updated_at TIMESTAMP DEFAULT NOW()
);

-- Token purchase history
CREATE TABLE token_purchases (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(id),
  tokens_purchased BIGINT NOT NULL,
  amount_eur DECIMAL(10, 2) NOT NULL,
  stripe_payment_intent_id VARCHAR(255),
  status VARCHAR(20) DEFAULT 'pending', -- 'pending', 'completed', 'failed'
  created_at TIMESTAMP DEFAULT NOW()
);

-- Monthly usage summary (for analytics)
CREATE TABLE monthly_token_usage (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(id),
  month DATE NOT NULL, -- First day of month
  tier VARCHAR(20) NOT NULL, -- 'free', 'essential', 'professional'
  total_tokens BIGINT NOT NULL,
  total_cost_eur DECIMAL(10, 2) NOT NULL,
  subscription_tokens BIGINT NOT NULL, -- Tokens included in subscription
  purchased_tokens_used BIGINT NOT NULL, -- On-demand tokens used
  created_at TIMESTAMP DEFAULT NOW(),
  UNIQUE(user_id, month)
);
```

### **Token Tracking Service**

```typescript
// lib/token-tracking.ts

export const TOKEN_COSTS = {
  'gemini-2.0-flash': {
    input: 0.00007, // €0.070 per 1M tokens
    output: 0.00028, // €0.28 per 1M tokens
  },
} as const

export async function trackTokenUsage(params: {
  userId: string
  operationType: string
  policyId?: string
  inputTokens: number
  outputTokens: number
  model: string
}) {
  const costs = TOKEN_COSTS[params.model as keyof typeof TOKEN_COSTS]
  
  const inputCost = (params.inputTokens / 1_000_000) * costs.input
  const outputCost = (params.outputTokens / 1_000_000) * costs.output
  const totalCost = inputCost + outputCost

  await prisma.tokenUsage.create({
    data: {
      userId: params.userId,
      operationType: params.operationType,
      policyId: params.policyId,
      inputTokens: params.inputTokens,
      outputTokens: params.outputTokens,
      costEur: totalCost,
      model: params.model,
    },
  })

  // Update monthly summary
  await updateMonthlyUsage(params.userId, params.inputTokens + params.outputTokens, totalCost)
}

export async function canUserUseTokens(userId: string, estimatedTokens: number): Promise<{
  allowed: boolean
  reason?: string
  remainingTokens?: number
}> {
  const { tier } = await getUserSubscription(userId)
  const monthlyUsage = await getMonthlyUsage(userId)
  
  // Get tier limits
  const limits = {
    free: 250_000, // 250K tokens/month
    essential: 1_000_000, // 1M tokens/month
    professional: 5_000_000, // 5M tokens/month
  }
  
  const limit = limits[tier]
  const used = monthlyUsage.total_tokens
  
  // Check subscription allowance
  if (used + estimatedTokens <= limit) {
    return { allowed: true, remainingTokens: limit - used }
  }
  
  // For paid users, check purchased token balance
  if (tier !== 'free') {
    const balance = await getTokenBalance(userId)
    if (balance.remaining_tokens >= estimatedTokens) {
      return { allowed: true, remainingTokens: balance.remaining_tokens }
    }
    
    return {
      allowed: false,
      reason: 'insufficient_tokens',
      remainingTokens: balance.remaining_tokens,
    }
  }
  
  return {
    allowed: false,
    reason: 'monthly_limit_reached',
    remainingTokens: 0,
  }
}
```

