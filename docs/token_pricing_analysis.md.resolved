## 💳 On-Demand Token Purchase Flow

### **1. Token Purchase API**

```typescript
// app/api/tokens/purchase/route.ts

export async function POST(req: Request) {
  const session = await getServerSession(authOptions)
  if (!session?.user?.id) {
    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
  }

  const { tier } = await getUserSubscription(session.user.id)
  
  // Only paid users can purchase tokens
  if (tier === 'free') {
    return NextResponse.json(
      { error: 'Token purchases are only available for paid plans' },
      { status: 403 }
    )
  }

  const { package: packageType } = await req.json()
  
  const packages = {
    small: { tokens: 500_000, price: 0.49 },
    medium: { tokens: 1_000_000, price: 0.99 },
    large: { tokens: 5_000_000, price: 4.99 },
    xl: { tokens: 10_000_000, price: 9.99 },
  }
  
  const pkg = packages[packageType as keyof typeof packages]
  
  // Create Stripe payment intent
  const paymentIntent = await stripe.paymentIntents.create({
    amount: Math.round(pkg.price * 100), // Convert to cents
    currency: 'eur',
    metadata: {
      userId: session.user.id,
      tokens: pkg.tokens,
      package: packageType,
    },
  })

  return NextResponse.json({ clientSecret: paymentIntent.client_secret })
}
```

### **2. Token Purchase Confirmation**

```typescript
// Webhook handler for token purchases

async function handleTokenPurchaseCompleted(paymentIntent: Stripe.PaymentIntent) {
  const userId = paymentIntent.metadata.userId
  const tokens = parseInt(paymentIntent.metadata.tokens)
  const amount = paymentIntent.amount / 100

  // Record purchase
  await prisma.tokenPurchase.create({
    data: {
      userId,
      tokensPurchased: tokens,
      amountEur: amount,
      stripePaymentIntentId: paymentIntent.id,
      status: 'completed',
    },
  })

  // Update balance
  await prisma.tokenBalance.upsert({
    where: { userId },
    create: {
      userId,
      purchasedTokens: tokens,
      usedTokens: 0,
      lastPurchaseAt: new Date(),
    },
    update: {
      purchasedTokens: { increment: tokens },
      lastPurchaseAt: new Date(),
    },
  })

  // Send confirmation email
  await sendTokenPurchaseConfirmation(userId, tokens, amount)
}
```

