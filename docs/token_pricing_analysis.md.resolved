## 📱 UI Components

### **Token Usage Dashboard**

```typescript
// components/account/TokenUsageCard.tsx

export function TokenUsageCard({ userId, language }: Props) {
  const { tier } = useSubscription()
  const usage = useMonthlyTokenUsage(userId)
  const balance = useTokenBalance(userId)
  
  const limits = {
    free: 250_000,
    essential: 1_000_000,
    professional: 5_000_000,
  }
  
  const limit = limits[tier]
  const percentage = (usage.total_tokens / limit) * 100
  
  return (
    <div className="bg-white dark:bg-slate-900 rounded-2xl border-2 p-6">
      <h3 className="text-xl font-bold mb-4">
        {language === 'el' ? 'Χρήση AI Tokens' : 'AI Token Usage'}
      </h3>
      
      {/* Subscription Allowance */}
      <div className="mb-6">
        <div className="flex justify-between mb-2">
          <span className="text-sm font-semibold">
            {language === 'el' ? 'Μηνιαία Χρήση' : 'Monthly Usage'}
          </span>
          <span className="text-sm font-bold">
            {formatTokens(usage.total_tokens)} / {formatTokens(limit)}
          </span>
        </div>
        <div className="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2.5">
          <div
            className={`h-full rounded-full ${
              percentage >= 90 ? 'bg-red-600' : percentage >= 75 ? 'bg-orange-500' : 'bg-blue-600'
            }`}
            style={{ width: `${Math.min(percentage, 100)}%` }}
          />
        </div>
      </div>
      
      {/* Purchased Token Balance (paid users only) */}
      {tier !== 'free' && (
        <div className="mb-6 p-4 bg-blue-50 dark:bg-blue-950/30 rounded-xl">
          <div className="flex justify-between items-center">
            <span className="text-sm font-semibold">
              {language === 'el' ? 'Επιπλέον Tokens' : 'Extra Tokens'}
            </span>
            <span className="text-lg font-black text-blue-600 dark:text-blue-400">
              {formatTokens(balance.remaining_tokens)}
            </span>
          </div>
        </div>
      )}
      
      {/* Purchase Button */}
      {tier !== 'free' && (
        <button
          onClick={() => openTokenPurchaseModal()}
          className="w-full px-6 py-3 bg-gradient-to-r from-blue-600 to-cyan-600 text-white font-bold rounded-xl"
        >
          {language === 'el' ? 'Αγορά Επιπλέον Tokens' : 'Buy Extra Tokens'}
        </button>
      )}
    </div>
  )
}
```

